@page
@model ePinPong.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card bg-dark-card border border-dark-glow rounded-4 shadow-lg overflow-hidden">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-4 text-center">
                <h3 class="text-white fw-bold mb-1"><i class="bi bi-box-arrow-in-right text-orange me-2"></i>Prijava</h3>
                <p class="text-white-50 mb-0">Prijavite se kako biste pristupili svom profilu i takmičenjima.</p>
            </div>
            <div class="card-body p-4">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label text-white fw-semibold">Email adresa</label>
                        <input asp-for="Input.Email" class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" placeholder="primjer@email.com..." />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label text-white fw-semibold">Lozinka</label>
                        <input asp-for="Input.Password" type="password" class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" placeholder="********" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input bg-dark-input border-dark-glow cursor-pointer" type="checkbox" asp-for="Input.RememberMe" id="rememberMeCheck" />
                        <label class="form-check-label text-white-50 small cursor-pointer" asp-for="Input.RememberMe">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <button type="submit" class="btn btn-orange w-100 py-2 text-white fw-bold shadow-glow">Prijavi se <i class="bi bi-box-arrow-in-right ms-1"></i></button>

                    <div class="text-center mt-3">
                        <p class="text-white-50 small mb-0">Nemate račun? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange fw-bold text-decoration-none">Registrujte se ovdje</a>.</p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
