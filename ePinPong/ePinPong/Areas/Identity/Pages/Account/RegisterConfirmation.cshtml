@page
@model ePinPong.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Potvrdite email";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card bg-dark-card border border-dark-glow rounded-4 shadow-lg overflow-hidden text-center p-4">
            <div class="mb-3">
                <i class="bi bi-envelope-check-fill text-orange display-1"></i>
            </div>
            <h2 class="text-white fw-bold mb-3">Registracija uspješna!</h2>
            <p class="text-white-50">
                Poslali smo email za potvrdu na adresu: <br />
                <strong class="text-warning">@Model.Email</strong>
            </p>
            <p class="text-white-50 small mb-4">
                Molimo provjerite vaš inbox (i spam folder) i kliknite na link u mailu kako biste aktivirali svoj račun i mogli se prijaviti.
            </p>
            <div>
                <a asp-page="Login" class="btn btn-orange px-4 py-2 fw-semibold rounded-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Idi na prijavu
                </a>
            </div>
        </div>
    </div>
</div>
