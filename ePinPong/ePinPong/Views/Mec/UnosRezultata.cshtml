@model ePinPong.Models.Mec
@{
    ViewData["Title"] = "Unos rezultata";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-lg-7">
        <div class="card bg-dark-card border border-dark-glow rounded-4 overflow-hidden shadow-lg">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow py-3 px-4 text-center">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <span class="badge bg-orange text-dark fw-bold rounded-pill px-3 py-1">UNOS REZULTATA</span>
                    @if (!string.IsNullOrEmpty(Model.NazivGrupe))
                    {
                        <span class="badge bg-dark-glow text-orange border border-dark-glow px-3 py-1">@Model.NazivGrupe</span>
                    }
                    <span class="badge bg-secondary text-white px-2 py-1">Runda @Model.Runda</span>
                </div>
                <h4 class="text-white fw-bold mt-2 mb-0">Turnir: @Model.Turnir?.Naziv</h4>
            </div>
            
            <div class="card-body p-3 p-md-4">
                <form id="unosRezultataForm" asp-controller="Mec" asp-action="UnosRezultata" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ID" />

                    <!-- Glavna kontrola rezultata -->
                    <div class="row align-items-center g-3 text-center mb-3">
                        <!-- Player 1 -->
                        <div class="col-12 col-md-5">
                            <div class="user-avatar-sm mx-auto mb-2 bg-orange-subtle text-orange rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 45px; height: 45px;">
                                @if (Model.Igrac1 != null && Model.Igrac1.Ime.Length > 0)
                                {
                                    <span>@Model.Igrac1.Ime[0]</span>
                                }
                                else
                                {
                                    <span>P</span>
                                }
                            </div>
                            <h6 class="text-white fw-bold mb-1">
                                @Model.Igrac1?.Ime @Model.Igrac1?.Prezime
                                @if (Model.TipMeca == TipMeca.TurnirParova && Model.Igrac1Partner != null)
                                {
                                    <span>/ @Model.Igrac1Partner.Ime @Model.Igrac1Partner.Prezime</span>
                                }
                            </h6>
                            <span class="text-muted extra-small d-block mb-2">
                                @Model.Igrac1?.Grad
                                @if (Model.TipMeca == TipMeca.TurnirParova && Model.Igrac1Partner != null && Model.Igrac1Partner.Grad != Model.Igrac1?.Grad)
                                {
                                    <span> &amp; @Model.Igrac1Partner.Grad</span>
                                }
                            </span>

                            <!-- P1 set counter -->
                            <div class="d-flex align-items-center justify-content-center gap-2">
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center" id="btnDecP1" style="width: 38px; height: 38px; border-width: 2px;">
                                    <i class="bi bi-dash-lg fs-5"></i>
                                </button>
                                <input type="text" id="poeniIgrac1" name="poeniIgrac1" class="form-control form-control-lg bg-dark border border-dark-glow text-white text-center fw-bold fs-3 font-monospace px-0" style="width: 65px; height: 48px;" readonly value="@(Model.PoeniIgrac1 ?? 0)" />
                                <button type="button" class="btn btn-outline-success btn-sm rounded-circle d-flex align-items-center justify-content-center" id="btnIncP1" style="width: 38px; height: 38px; border-width: 2px;">
                                    <i class="bi bi-plus-lg fs-5"></i>
                                </button>
                            </div>
                        </div>

                        <!-- VS separator -->
                        <div class="col-12 col-md-2 my-2 my-md-0">
                            <div class="vs-badge bg-orange text-dark rounded-circle mx-auto fw-bold d-flex align-items-center justify-content-center font-monospace shadow-glow" style="width: 42px; height: 42px; font-size: 1.1rem;">VS</div>
                        </div>

                        <!-- Player 2 -->
                        <div class="col-12 col-md-5">
                            <div class="user-avatar-sm mx-auto mb-2 bg-orange-subtle text-orange rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 45px; height: 45px;">
                                @if (Model.Igrac2 != null && Model.Igrac2.Ime.Length > 0)
                                {
                                    <span>@Model.Igrac2.Ime[0]</span>
                                }
                                else
                                {
                                    <span>P</span>
                                }
                            </div>
                            <h6 class="text-white fw-bold mb-1">
                                @Model.Igrac2?.Ime @Model.Igrac2?.Prezime
                                @if (Model.TipMeca == TipMeca.TurnirParova && Model.Igrac2Partner != null)
                                {
                                    <span>/ @Model.Igrac2Partner.Ime @Model.Igrac2Partner.Prezime</span>
                                }
                            </h6>
                            <span class="text-muted extra-small d-block mb-2">
                                @Model.Igrac2?.Grad
                                @if (Model.TipMeca == TipMeca.TurnirParova && Model.Igrac2Partner != null && Model.Igrac2Partner.Grad != Model.Igrac2?.Grad)
                                {
                                    <span> &amp; @Model.Igrac2Partner.Grad</span>
                                }
                            </span>

                            <!-- P2 set counter -->
                            <div class="d-flex align-items-center justify-content-center gap-2">
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center" id="btnDecP2" style="width: 38px; height: 38px; border-width: 2px;">
                                    <i class="bi bi-dash-lg fs-5"></i>
                                </button>
                                <input type="text" id="poeniIgrac2" name="poeniIgrac2" class="form-control form-control-lg bg-dark border border-dark-glow text-white text-center fw-bold fs-3 font-monospace px-0" style="width: 65px; height: 48px;" readonly value="@(Model.PoeniIgrac2 ?? 0)" />
                                <button type="button" class="btn btn-outline-success btn-sm rounded-circle d-flex align-items-center justify-content-center" id="btnIncP2" style="width: 38px; height: 38px; border-width: 2px;">
                                    <i class="bi bi-plus-lg fs-5"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Obavijesti o pobjedniku i validaciji -->
                    <div class="mb-3 text-center">
                        <div id="pobjednikObavjest" class="alert bg-success-transparent border border-success text-success rounded-3 py-2 px-3 fw-bold small d-none mb-2">
                            <i class="bi bi-trophy-fill me-2 fs-6"></i> Pobjednik meča: <span id="imePobjednika"></span>
                        </div>
                        <div id="statusPoruka" class="alert bg-dark border border-dark-glow text-white-50 rounded-3 py-2 px-3 small mb-0">
                            Jedan igrač mora osvojiti tačno 3 seta (npr. 3:0, 3:1, 3:2).
                        </div>
                    </div>

                    <!-- Akcije -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-dark-glow">
                        <a href="/Turnir/Details/@Model.TurnirID" class="btn btn-outline-light-glow text-white fw-bold btn-sm"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
                        <button type="submit" id="btnSpremi" class="btn btn-orange px-4 py-2 text-white fw-bold shadow-glow btn-sm" disabled>Spremi rezultat <i class="bi bi-check2-circle ms-1"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const player1Name = "@Model.Igrac1?.Ime @Model.Igrac1?.Prezime" + ("@Model.TipMeca" === "TurnirParova" && "@Model.Igrac1Partner" !== "" ? " / @Model.Igrac1Partner?.Ime @Model.Igrac1Partner?.Prezime" : "");
            const player2Name = "@Model.Igrac2?.Ime @Model.Igrac2?.Prezime" + ("@Model.TipMeca" === "TurnirParova" && "@Model.Igrac2Partner" !== "" ? " / @Model.Igrac2Partner?.Ime @Model.Igrac2Partner?.Prezime" : "");

            const poeniIgrac1 = document.getElementById("poeniIgrac1");
            const poeniIgrac2 = document.getElementById("poeniIgrac2");

            const btnDecP1 = document.getElementById("btnDecP1");
            const btnIncP1 = document.getElementById("btnIncP1");
            const btnDecP2 = document.getElementById("btnDecP2");
            const btnIncP2 = document.getElementById("btnIncP2");

            const btnSpremi = document.getElementById("btnSpremi");
            const pobjednikObavjest = document.getElementById("pobjednikObavjest");
            const imePobjednika = document.getElementById("imePobjednika");
            const statusPoruka = document.getElementById("statusPoruka");

            function updateUI() {
                const val1 = parseInt(poeniIgrac1.value, 10) || 0;
                const val2 = parseInt(poeniIgrac2.value, 10) || 0;

                // Onemogući minus ako je 0
                btnDecP1.disabled = (val1 <= 0);
                btnDecP2.disabled = (val2 <= 0);

                // Meč završava kada jedan igrač ima tačno 3 seta
                const matchFinished = (val1 === 3 || val2 === 3);

                // Ako je meč završen, onemogući daljnji plus
                btnIncP1.disabled = matchFinished || (val1 >= 3);
                btnIncP2.disabled = matchFinished || (val2 >= 3);

                if (matchFinished) {
                    btnSpremi.disabled = false;
                    pobjednikObavjest.classList.remove("d-none");
                    imePobjednika.textContent = val1 === 3 ? player1Name : player2Name;
                    
                    statusPoruka.className = "alert alert-success border border-success bg-success-transparent p-3 fw-bold";
                    statusPoruka.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Rezultat je spreman za potvrdu! Kliknite na "Spremi rezultat".';
                } else {
                    btnSpremi.disabled = true;
                    pobjednikObavjest.classList.add("d-none");
                    
                    statusPoruka.className = "alert bg-dark border border-dark-glow text-white-50 p-3";
                    statusPoruka.textContent = "Unesite konačni rezultat meča. Jedan igrač mora osvojiti tačno 3 seta (npr. 3:0, 3:1, 3:2).";
                }
            }

            btnIncP1.addEventListener("click", function() {
                let val = parseInt(poeniIgrac1.value, 10) || 0;
                if (val < 3) {
                    poeniIgrac1.value = val + 1;
                    updateUI();
                }
            });

            btnDecP1.addEventListener("click", function() {
                let val = parseInt(poeniIgrac1.value, 10) || 0;
                if (val > 0) {
                    poeniIgrac1.value = val - 1;
                    updateUI();
                }
            });

            btnIncP2.addEventListener("click", function() {
                let val = parseInt(poeniIgrac2.value, 10) || 0;
                if (val < 3) {
                    poeniIgrac2.value = val + 1;
                    updateUI();
                }
            });

            btnDecP2.addEventListener("click", function() {
                let val = parseInt(poeniIgrac2.value, 10) || 0;
                if (val > 0) {
                    poeniIgrac2.value = val - 1;
                    updateUI();
                }
            });

            // Inicijalni UI update
            updateUI();
        });
    </script>
}
