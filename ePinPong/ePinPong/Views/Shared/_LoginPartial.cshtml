@using Microsoft.AspNetCore.Identity
@using ePinPong.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var imePrezime = user != null ? $"{user.Ime} {user.Prezime}" : User.Identity?.Name;
    var userId = UserManager.GetUserId(User);

    <li class="nav-item dropdown me-2">
        <a class="nav-link dropdown-toggle btn-user-profile d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar-mini me-2">
                @if (user != null && user.Ime.Length > 0 && user.Prezime.Length > 0)
                {
                    <span>@user.Ime[0]@user.Prezime[0]</span>
                }
                else
                {
                    <span>U</span>
                }
            </div>
            <span class="d-none d-md-inline">@imePrezime</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end bg-dark-card border border-dark-glow animate slideIn" aria-labelledby="navbarDropdown">
            <li>
                <a class="dropdown-item text-white hover-orange d-flex align-items-center" asp-controller="Korisnik" asp-action="Index" asp-route-id="@userId">
                    <i class="bi bi-person-badge-fill me-2 text-orange"></i>Moj Profil
                </a>
            </li>
            <li><hr class="dropdown-divider border-secondary"></li>
            <li>
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item text-danger hover-red d-flex align-items-center w-100 border-0 bg-transparent">
                        <i class="bi bi-box-arrow-right me-2 text-danger"></i>Odjavi se
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-outline-light-glow me-2 px-3 py-1" asp-area="Identity" asp-page="/Account/Login">
            Prijavi se
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-orange px-3 py-1 text-white fw-bold shadow-glow" asp-area="Identity" asp-page="/Account/Register">
            Registracija
        </a>
    </li>
}
</ul>
