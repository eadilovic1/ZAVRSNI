@model ePinPong.Models.ViewModels.TurnirDetailsViewModel

<!-- Turnir kartica / zaglavlje -->
<div class="card bg-dark-card border border-dark-glow rounded-4 overflow-hidden shadow-lg mb-4">
    <div class="tournament-header-banner position-relative">
        @if (!string.IsNullOrEmpty(Model.SlikaUrl))
        {
            <img src="@Model.SlikaUrl" class="w-100 banner-img" alt="@Model.Naziv" />
        }
        else
        {
            <div class="banner-placeholder d-flex align-items-center justify-content-center">
                <span class="display-1">🏓</span>
            </div>
        }
        <div class="banner-overlay p-4 d-flex align-items-end justify-content-between">
            <div>
                <span class="badge bg-orange text-white fw-bold mb-2 rounded-pill px-3 py-2 me-1 shadow-sm" style="text-shadow: 0 1px 2px rgba(0,0,0,.5);">
                    @if (Model.TipTakmicenja == ePinPong.Models.TipTakmicenja.Singl) { <i class="bi bi-person-fill me-1"></i>@("Samo Singl") }
                    else if (Model.TipTakmicenja == ePinPong.Models.TipTakmicenja.Dubl) { <i class="bi bi-people-fill me-1"></i>@("Samo Dubl") }
                    else { <i class="bi bi-diagram-2-fill me-1"></i>@("Singl + Dubl") }
                </span>
                <span class="badge bg-dark border border-dark-glow text-white fw-bold mb-2 rounded-pill px-3 py-2">
                    @if (Model.SistemTurnira == ePinPong.Models.SistemTurnira.SingleElimination) { <i class="bi bi-trophy me-1 text-warning"></i>@("Single Elimination") }
                    else if (Model.SistemTurnira == ePinPong.Models.SistemTurnira.DoubleElimination) { <i class="bi bi-diagram-3-fill me-1 text-info"></i>@("Double Elimination") }
                    else { <i class="bi bi-patch-check-fill me-1 text-orange"></i>@("Double Elimination + Utješni") }
                </span>
                <h2 class="text-white fw-bold mb-0">@Model.Naziv</h2>
            </div>
            <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">@Model.Status</span>
        </div>
    </div>

    <div class="card-body p-4">
        <h4 class="text-white fw-bold mb-3"><i class="bi bi-info-circle-fill text-orange me-2"></i>Opis turnira</h4>
        <p class="text-white-50 lead fs-6">@Model.Opis</p>

        <hr class="border-secondary my-4">

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="d-flex align-items-center text-white-50">
                    <i class="bi bi-geo-alt-fill text-orange fs-4 me-3"></i>
                    <div>
                        <small class="text-muted d-block">Lokacija</small>
                        <strong class="text-white">@Model.Lokacija</strong>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="d-flex align-items-center text-white-50">
                    <i class="bi bi-calendar-event-fill text-orange fs-4 me-3"></i>
                    <div>
                        <small class="text-muted d-block">Datum početka</small>
                        <strong class="text-white">@Model.DatumPocetka.ToString("dd.MM.yyyy HH:mm")</strong>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="d-flex align-items-center text-white-50">
                    <i class="bi bi-people-fill text-orange fs-4 me-3"></i>
                    <div>
                        <small class="text-muted d-block">Maksimalno igrača</small>
                        <strong class="text-white">@Model.MaxIgraca</strong>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="d-flex align-items-center text-white-50">
                    <i class="bi bi-person-fill text-orange fs-4 me-3"></i>
                    <div>
                        <small class="text-muted d-block">Organizator</small>
                        <a href="/Korisnik/Index/@Model.OrganizatorId" class="text-orange hover-white fw-bold">
                            @Model.Organizator?.Ime @Model.Organizator?.Prezime
                        </a>
                    </div>
                </div>
            </div>
            @if (Model.Liga != null)
            {
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center text-white-50">
                        <i class="bi bi-trophy-fill text-orange fs-4 me-3"></i>
                        <div>
                            <small class="text-muted d-block">Liga</small>
                            <a asp-controller="Liga" asp-action="Details" asp-route-id="@Model.LigaID" class="text-orange hover-white fw-bold">
                                @Model.Liga.Naziv
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.IsOrganizator)
        {
            <div class="mt-4 p-3 bg-dark-card border border-warning rounded-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="text-warning fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Organizatorski panel</span>
                    <small class="d-block text-white-50">Kao organizator možete mijenjati podatke i upravljati mečevima.</small>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-outline-warning btn-sm fw-bold px-3 py-2 text-nowrap flex-shrink-0">
                        <i class="bi bi-pencil-square me-1"></i>Uredi turnir
                    </a>
                </div>
            </div>
        }
    </div>
</div>