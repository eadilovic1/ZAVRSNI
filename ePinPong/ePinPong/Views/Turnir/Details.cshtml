@model ePinPong.Models.Turnir
@using ePinPong.Models.ViewModels
@{
    ViewData["Title"] = Model.Naziv;
    var isRegistered = ViewBag.IsRegistered as bool? ?? false;
    var isOrganizator = ViewBag.IsOrganizator as bool? ?? false;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var currentUserId = ViewBag.CurrentUserId as string;

    var grupniMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.GrupnaFaza).ToList();
    var zavrsniMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.Zavrsnica && m.MatchCode.StartsWith("Z_")).ToList();
    var razigravanjeMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.Razigravanje && m.MatchCode.StartsWith("PL_")).ToList();
    var sviZavrsniMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.Zavrsnica).ToList();
    var ranking = ViewBag.Ranking as List<TurnirPlasmanViewModel>;
    var playerPoints = ViewBag.PlayerPoints as Dictionary<string, int> ?? new Dictionary<string, int>();
    var isMasters = ViewBag.IsMasters as bool? ?? false;
    var utjesniMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.Utjesni && m.MatchCode.StartsWith("UT_")).ToList();
    var utjesniGlavniMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.Utjesni && (m.MatchCode.StartsWith("UT_R") && !m.MatchCode.StartsWith("UT_RR_"))).ToList();
    var utjesniRazigravanjeMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.Utjesni && (m.MatchCode.StartsWith("UT_PL_") || m.MatchCode.StartsWith("UT_RR_"))).ToList();
    // Detektuj group-only turnir: 1 grupa sa svim igračima, bez završnice/utješnog (npr. 5 igrača) ili Masters turnir
    var brojGrupaUTurniru = grupniMecevi.Select(m => m.NazivGrupe).Where(n => !string.IsNullOrEmpty(n)).Distinct().Count();
    var isGroupOnly = grupniMecevi.Any() && !sviZavrsniMecevi.Any() && !utjesniMecevi.Any() && (brojGrupaUTurniru == 1 || isMasters);
}

<style>
    .nav-pills .nav-link {
        background-color: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
    }
    .nav-pills .nav-link:hover {
        background-color: rgba(255, 120, 0, 0.1);
        color: #ff7800 !important;
    }
    .nav-pills .nav-link.active,
    .nav-pills .nav-link.active.text-white {
        background-color: #ff7800 !important;
        color: #000000 !important;
        box-shadow: 0 0 15px rgba(255, 120, 0, 0.4);
    }
    .nav-pills .nav-link.active i,
    .nav-pills .nav-link.active .text-orange {
        color: #000000 !important;
    }
    .bg-success-transparent-row {
        background-color: rgba(40, 167, 69, 0.1) !important;
    }
    .bg-warning-transparent-row {
        background-color: rgba(255, 193, 7, 0.15) !important;
    }
    .toggle-chevron {
        transition: transform 0.2s ease-in-out;
        display: inline-block;
    }
    .btn-collapse-toggle[aria-expanded="false"] .toggle-chevron {
        transform: rotate(180deg);
    }
    .user-avatar-mini-x {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.75rem;
        color: #ff7800;
        border: 1px solid rgba(255, 120, 0, 0.2);
    }
    .player-draggable-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }
    .player-draggable-card:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
        border-color: rgba(255, 120, 0, 0.2) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }
    .player-draggable-card.dragging {
        opacity: 0.4;
        border: 1px dashed #ff7800 !important;
        transform: scale(0.98);
    }
    .pot-drop-zone {
        border: 1px dashed transparent;
        border-radius: 6px;
    }
    .pot-drop-zone.dragover {
        background-color: rgba(255, 120, 0, 0.05) !important;
        border-color: rgba(255, 120, 0, 0.3) !important;
    }
    .bg-info-transparent {
        background-color: rgba(23, 162, 184, 0.08) !important;
    }
    .bg-danger-transparent {
        background-color: rgba(220, 53, 69, 0.08) !important;
    }
</style>

<div class="row g-4 py-4">
    <!-- Lijevi dio: Detalji turnira i akcije -->
    <div class="col-12 col-lg-8">
        <!-- Turnir kartica / zaglavlje -->
        <div class="card bg-dark-card border border-dark-glow rounded-4 overflow-hidden shadow-lg mb-4">
            <div class="tournament-header-banner position-relative">
                @if (!string.IsNullOrEmpty(Model.SlikaUrl))
                {
                    <img src="@Model.SlikaUrl" class="w-100 banner-img" alt="@Model.Naziv" />
                }
                else
                {
                    <div class="banner-placeholder d-flex align-items-center justify-content-center">
                        <span class="display-1">🏓</span>
                    </div>
                }
                <div class="banner-overlay p-4 d-flex align-items-end justify-content-between">
                    <div>
                        <span class="badge bg-orange text-white fw-bold mb-2 rounded-pill px-3 py-2 me-1 shadow-sm" style="text-shadow: 0 1px 2px rgba(0,0,0,.5);">
                            @if (Model.TipTakmicenja == ePinPong.Models.TipTakmicenja.Singl) { <i class="bi bi-person-fill me-1"></i>@("Samo Singl") }
                            else if (Model.TipTakmicenja == ePinPong.Models.TipTakmicenja.Dubl) { <i class="bi bi-people-fill me-1"></i>@("Samo Dubl") }
                            else { <i class="bi bi-diagram-2-fill me-1"></i>@("Singl + Dubl") }
                        </span>
                        <span class="badge bg-dark border border-dark-glow text-white fw-bold mb-2 rounded-pill px-3 py-2">
                            @if (Model.SistemTurnira == ePinPong.Models.SistemTurnira.SingleElimination) { <i class="bi bi-trophy me-1 text-warning"></i>@("Single Elimination") }
                            else if (Model.SistemTurnira == ePinPong.Models.SistemTurnira.DoubleElimination) { <i class="bi bi-diagram-3-fill me-1 text-info"></i>@("Double Elimination") }
                            else { <i class="bi bi-patch-check-fill me-1 text-orange"></i>@("Double Elimination + Utješni") }
                        </span>
                        <h2 class="text-white fw-bold mb-0">@Model.Naziv</h2>
                    </div>
                    <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">@Model.Status</span>
                </div>
            </div>
            
            <div class="card-body p-4">
                <h4 class="text-white fw-bold mb-3"><i class="bi bi-info-circle-fill text-orange me-2"></i>Opis turnira</h4>
                <p class="text-white-50 lead fs-6">@Model.Opis</p>
                
                <hr class="border-secondary my-4">

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center text-white-50">
                            <i class="bi bi-geo-alt-fill text-orange fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Lokacija</small>
                                <strong class="text-white">@Model.Lokacija</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center text-white-50">
                            <i class="bi bi-calendar-event-fill text-orange fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Datum početka</small>
                                <strong class="text-white">@Model.DatumPocetka.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center text-white-50">
                            <i class="bi bi-people-fill text-orange fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Maksimalno igrača</small>
                                <strong class="text-white">@Model.MaxIgraca</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center text-white-50">
                            <i class="bi bi-person-fill text-orange fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Organizator</small>
                                <a href="/Korisnik/Index/@Model.OrganizatorId" class="text-orange hover-white fw-bold">
                                    @Model.Organizator?.Ime @Model.Organizator?.Prezime
                                </a>
                            </div>
                        </div>
                    </div>
                    @if (Model.Liga != null)
                    {
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-center text-white-50">
                                <i class="bi bi-trophy-fill text-orange fs-4 me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Liga</small>
                                    <a asp-controller="Liga" asp-action="Details" asp-route-id="@Model.LigaID" class="text-orange hover-white fw-bold">
                                        @Model.Liga.Naziv @(Model.Kolo.HasValue ? $"- Kolo {Model.Kolo.Value}" : "")
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (isOrganizator && (isAdmin || Model.Status != StatusTurnira.Zavrsen))
                {
                    <div class="mt-4 p-3 bg-dark-card border border-warning rounded-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <span class="text-warning fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Organizatorski panel</span>
                            <small class="d-block text-white-50">Kao organizator možete mijenjati podatke i upravljati mečevima.</small>
                        </div>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning fw-bold px-4 py-2">
                                <i class="bi bi-pencil-square me-2"></i>Uredi turnir
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if ((Model.Status == StatusTurnira.Zavrsen || (isGroupOnly && grupniMecevi.Any() && grupniMecevi.All(m => m.Odigran))) && ranking != null && ranking.Any())
        {
            <!-- Krajnji poredak turnira -->
            <div class="card bg-dark-card border border-warning rounded-4 overflow-hidden shadow-lg mb-4">
                <div class="card-header bg-dark-card-footer border-bottom border-warning p-4 d-flex align-items-center justify-content-between">
                    <h4 class="text-white fw-bold mb-0">
                        <i class="bi bi-trophy-fill text-warning me-2"></i>Krajnji poredak turnira
                    </h4>
                    <button class="btn btn-outline-warning btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" type="button" data-bs-toggle="collapse" data-bs-target="#finalRankingCollapse" aria-expanded="true" aria-controls="finalRankingCollapse">
                        <i class="bi bi-chevron-up toggle-chevron"></i>
                    </button>
                </div>
                <div class="collapse show" id="finalRankingCollapse">
                    <div class="card-body p-4">
                    <div class="table-responsive rounded-3 overflow-hidden border border-dark-glow">
                        <table class="table table-dark table-striped align-middle mb-0 text-center">
                            <thead>
                                <tr class="text-muted small border-bottom border-dark-glow">
                                    <th style="width: 10%;">Pozicija</th>
                                    <th class="text-start" style="width: 40%;">Igrač</th>
                                    <th style="width: 25%;">Ostvareni rezultat</th>
                                    <th style="width: 25%;">Osvojeni bodovi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var plasman in ranking)
                                {
                                    var jePobjednik = plasman.Pozicija == 1;
                                    var jeDrugi = plasman.Pozicija == 2;
                                    var jeTreci = plasman.Pozicija == 3;

                                    <tr class="@(jePobjednik ? "border-start border-3 border-warning bg-warning-transparent-row" : (jeDrugi ? "border-start border-3 border-secondary" : ""))">
                                        <td class="fw-bold fs-5">
                                            @if (jePobjednik)
                                            {
                                                <span class="text-warning">🥇 1.</span>
                                            }
                                            else if (jeDrugi)
                                            {
                                                <span class="text-light">🥈 2.</span>
                                            }
                                            else if (jeTreci)
                                            {
                                                <span class="text-orange">🥉 @(plasman.Pozicija).</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@(plasman.Pozicija).</span>
                                            }
                                        </td>
                                        <td class="text-start">
                                            <div class="d-flex align-items-center">
                                                <div class="user-avatar-mini me-3 @(jePobjednik ? "bg-warning text-dark" : "")">
                                                    @if (!string.IsNullOrEmpty(plasman.ImePrezime) && plasman.ImePrezime.Length > 0)
                                                    {
                                                        <span>@plasman.ImePrezime[0]</span>
                                                    }
                                                    else
                                                    {
                                                        <span>I</span>
                                                    }
                                                </div>
                                                <div>
                                                    <a href="/Korisnik/Index/@plasman.KorisnikId" class="text-white hover-orange fw-bold">
                                                        @plasman.ImePrezime
                                                        @if (plasman.IsGost)
                                                        {
                                                            <span class="badge bg-secondary text-muted ms-1" style="font-size: 0.75rem;">Gost</span>
                                                        }
                                                    </a>
                                                    <small class="d-block text-muted" style="font-size: 0.75rem;">@plasman.Grad</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-dark-glow border border-dark-glow px-3 py-2 text-white fw-semibold">
                                                @plasman.DetaljPozicije
                                            </span>
                                        </td>
                                        <td class="fw-bold text-warning fs-5">
                                            +@plasman.Bodovi <span class="small text-muted fs-6">bodova</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                </div>
            </div>
        }

        <!-- Raspored mečeva i tabele -->
        <div class="card bg-dark-card border border-dark-glow rounded-4 overflow-hidden shadow-lg mb-4">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-4 d-flex justify-content-between align-items-center">
                <h4 class="text-white fw-bold mb-0"><i class="bi bi-grid-3x3-gap-fill text-orange me-2"></i>Raspored mečeva i tabele</h4>
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-light-glow btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" type="button" data-bs-toggle="collapse" data-bs-target="#overallScheduleCollapse" aria-expanded="true" aria-controls="overallScheduleCollapse">
                        <i class="bi bi-chevron-up toggle-chevron"></i>
                    </button>
                </div>
            </div>
            <div class="collapse show" id="overallScheduleCollapse">
                <div class="card-body p-4">
                @if (!Model.Mecevi.Any())
                {
                    @if (Model.Status == StatusTurnira.Planiran && Model.Registracije.Count >= 3)
                    {
                        @if (isMasters)
                        {
                            <div class="p-4 bg-dark-input border border-dark-glow rounded-4 mb-4">
                                <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
                                    <div>
                                        <h4 class="text-white fw-bold mb-1"><i class="bi bi-bar-chart-line-fill text-orange me-2"></i>Prijavljeni igrači po kvalitetu</h4>
                                        <p class="text-white-50 small mb-0">Igrači su prikazani po kvalitetu iz lige. Najbolji rangirani igrači idu u prve grupe, dok ostali idu u zadnje grupe.</p>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    @{
                                        var sortedRegistrations = Model.Registracije
                                            .OrderByDescending(r => playerPoints.ContainsKey(r.KorisnikID) ? playerPoints[r.KorisnikID] : 0)
                                            .ThenBy(r => playerPoints.ContainsKey(r.KorisnikID) ? 0 : 1)
                                            .ThenBy(r => r.DatumRegistracije)
                                            .ToList();
                                    }

                                    @foreach (var reg in sortedRegistrations)
                                    {
                                        var bodovi = playerPoints.ContainsKey(reg.KorisnikID) ? playerPoints[reg.KorisnikID] : 0;
                                        <div class="col-12 col-md-6">
                                            <div class="card bg-dark-card border border-dark-glow rounded-3 p-3">
                                                <div class="d-flex align-items-center justify-content-between gap-3">
                                                    <div>
                                                        <strong class="text-white">@reg.Korisnik?.Ime @reg.Korisnik?.Prezime</strong>
                                                        <div class="text-white-50 small mt-1">@reg.Korisnik?.Grad</div>
                                                    </div>
                                                    <span class="badge bg-warning text-dark">Bodovi: @bodovi</span>
                                                </div>
                                                <div class="d-flex align-items-center justify-content-between mt-3">
                                                    <span class="badge bg-secondary text-muted">Prijavljeno: @reg.DatumRegistracije.ToString("dd.MM.yyyy")</span>
                                                    @if (reg.Korisnik != null && reg.Korisnik.IsGost)
                                                    {
                                                        <span class="badge bg-secondary text-muted">Gost</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (isOrganizator)
                                {
                                    <div class="mt-4 border-top border-dark-glow pt-3 d-flex justify-content-end">
                                        <form asp-controller="Mec" asp-action="GenerirajBracket" method="post" id="formGenerisiGrupe">
                                            <input type="hidden" name="turnirId" value="@Model.ID" />
                                            <button type="submit" class="btn btn-orange text-white fw-bold px-4 py-2"><i class="bi bi-lightning-fill me-2"></i>Generiši grupe i započni Masters</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- PANEL ZA ŠEŠIRE I ŽRIJEB -->
                            <div class="seeding-container p-4 bg-dark-input border border-dark-glow rounded-4">
                                <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
                                    <div>
                                        <h4 class="text-white fw-bold mb-1"><i class="bi bi-trophy-fill text-orange me-2"></i>Raspodjela po šeširima (Seeding Pots)</h4>
                                        <p class="text-white-50 small mb-0">Igrači su raspoređeni u 4 jakosne skupine. Svaka grupa se sastoji od po jednog igrača iz svakog šešira.</p>
                                    </div>
                                    @if (isOrganizator)
                                    {
                                        <div class="d-flex gap-2 align-items-center flex-wrap">
                                            <div class="dropdown">
                                                <select id="seedingSourceType" class="form-select bg-dark-card border-dark-glow text-white form-select-sm" style="min-width: 170px;">
                                                    <option value="TrenutnaLiga">Pravilo: Trenutna liga</option>
                                                    <option value="DrugaLiga">Izvor: Druga liga...</option>
                                                    <option value="DrugiTurnir">Izvor: Drugi turnir...</option>
                                                    <option value="Random">Pravilo: Random (Nasumično)</option>
                                                </select>
                                            </div>
                                            <div id="seedingSourceLigaContainer" class="d-none">
                                                <select id="seedingSourceLiga" class="form-select bg-dark-card border-dark-glow text-white form-select-sm" asp-items="ViewBag.LigeZaSeeding">
                                                    <option value="">-- Odaberi ligu --</option>
                                                </select>
                                            </div>
                                            <div id="seedingSourceTurnirContainer" class="d-none">
                                                <select id="seedingSourceTurnir" class="form-select bg-dark-card border-dark-glow text-white form-select-sm" asp-items="ViewBag.TurniriZaSeeding">
                                                    <option value="">-- Odaberi turnir --</option>
                                                </select>
                                            </div>
                                            <button type="button" id="btnAutoSeeding" class="btn btn-outline-warning btn-sm fw-bold"><i class="bi bi-magic me-1"></i> Auto-raspodjela</button>
                                        </div>
                                    }
                                </div>

                                <!-- Statusna traka i validacija -->
                                <div id="validationAlert" class="alert alert-info border border-info bg-info-transparent d-flex align-items-center justify-content-between py-2 px-3 mb-4 rounded-3 small">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">ℹ️</span>
                                        <span id="validationText">Validacija šešira...</span>
                                    </div>
                                    <span id="validationStatusBadge" class="badge bg-secondary">Provjera</span>
                                </div>

                                <!-- 4 Šešira kolone -->
                                <div class="row g-3">
                                    @for (int s = 1; s <= 4; s++)
                                    {
                                        var sesirPlayers = Model.Registracije.Where(r => r.Sesir == s).ToList();
                                        string colorText = s == 1 ? "text-danger" : s == 2 ? "text-warning" : s == 3 ? "text-primary" : "text-success";
                                        
                                        <div class="col-12 col-md-3">
                                            <div class="card bg-dark-card border border-dark-glow rounded-3 overflow-hidden h-100 shadow-sm">
                                                <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-3 d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold @colorText">Šešir @s</span>
                                                    <span class="badge bg-dark border border-dark-glow text-muted pot-counter" id="pot-counter-@s">0/0</span>
                                                </div>
                                                <div class="card-body p-2 pot-drop-zone d-flex flex-column gap-2" id="pot-zone-@s" data-pot="@s" style="min-height: 250px; background-color: rgba(255,255,255,0.01); transition: background-color 0.2s;">
                                                    @foreach (var reg in sesirPlayers)
                                                    {
                                                        var bodovi = ViewBag.PlayerPoints != null && ViewBag.PlayerPoints.ContainsKey(reg.KorisnikID) ? ViewBag.PlayerPoints[reg.KorisnikID] : 0;
                                                        <div class="player-draggable-card p-2 bg-dark border border-dark-glow rounded d-flex align-items-center justify-content-between" 
                                                             draggable="@(isOrganizator ? "true" : "false")" 
                                                             data-player-id="@reg.KorisnikID" 
                                                             data-reg-date="@reg.DatumRegistracije.ToString("o")"
                                                             data-points="@bodovi"
                                                             style="cursor: @(isOrganizator ? "grab" : "default");">
                                                            <div class="d-flex align-items-center min-w-0">
                                                                <div class="user-avatar-mini-x me-2 bg-dark-glow">
                                                                    @if (reg.Korisnik != null && reg.Korisnik.Ime.Length > 0)
                                                                    {
                                                                        <span>@reg.Korisnik.Ime[0]</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>I</span>
                                                                    }
                                                                </div>
                                                                <div class="text-truncate">
                                                                    <small class="text-white fw-bold d-block text-truncate lh-1">@reg.Korisnik?.Ime @reg.Korisnik?.Prezime</small>
                                                                    <span class="text-muted" style="font-size: 0.65rem;">Bodovi: <strong class="player-points-text">@bodovi</strong></span>
                                                                </div>
                                                            </div>
                                                            @if (isOrganizator)
                                                            {
                                                                <i class="bi bi-grip-vertical text-muted fs-6 ms-1"></i>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (isOrganizator)
                                {
                                    <div class="mt-4 border-top border-dark-glow pt-3 d-flex justify-content-end">
                                        <form asp-controller="Mec" asp-action="GenerirajBracket" method="post" id="formGenerisiGrupe">
                                            <input type="hidden" name="turnirId" value="@Model.ID" />
                                            <input type="hidden" name="playerPotsJson" id="playerPotsJson" value="" />
                                            <button type="submit" id="btnGenerisiGrupeSubmit" class="btn btn-orange text-white fw-bold px-4 py-2"><i class="bi bi-lightning-fill me-2"></i>Generiši grupe i započni turnir</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-info-circle text-white-50 fs-2 mb-3"></i>
                            <h5 class="text-white">Mečevi još nisu generisani</h5>
                            <p class="text-white-50 small mb-0">Raspored mečeva i tabele će biti dostupni kada organizator pokrene generisanje grupa. Za početak turnira potrebna su najmanje 3 igrača.</p>
                        </div>
                    }
                }
                else
                {
                    @if (!isMasters)
                    {
                        <!-- Navigacijski tabovi u jednom redu s dugmadima za skrolanje lijevo / desno -->
                        <div class="position-relative d-flex align-items-center mb-4 gap-2">
                            <button type="button" class="btn btn-dark border border-dark-glow text-orange rounded-3 px-3 py-3 shadow-sm d-flex align-items-center justify-content-center" id="scrollTabsLeft" title="Skroluj skroz ulijevo" style="flex-shrink: 0;">
                                <i class="bi bi-chevron-left fs-5"></i>
                            </button>

                            <div class="overflow-hidden flex-grow-1 border border-dark-glow rounded-3 p-1 bg-dark-card" id="tournamentTabsScrollContainer" style="scroll-behavior: smooth;">
                                <ul class="nav nav-pills flex-nowrap mb-0 border-0" id="tournamentTabs" role="tablist">
                                    @if (Model.TipTakmicenja != ePinPong.Models.TipTakmicenja.Dubl)
                                    {
                                        <li class="nav-item flex-shrink-0" role="presentation">
                                            <button class="nav-link active text-white fw-bold py-3 px-4 rounded-3 text-nowrap" id="groups-tab" data-bs-toggle="pill" data-bs-target="#groups-pane" type="button" role="tab" aria-controls="groups-pane" aria-selected="true">
                                                <i class="bi bi-grid-3x3-gap-fill text-orange me-2"></i>Grupna Faza
                                            </button>
                                        </li>
                                        @if (!isGroupOnly)
                                        {
                                        <li class="nav-item flex-shrink-0" role="presentation">
                                            <button class="nav-link text-white fw-bold py-3 px-4 rounded-3 text-nowrap" id="knockout-tab" data-bs-toggle="pill" data-bs-target="#knockout-pane" type="button" role="tab" aria-controls="knockout-pane" aria-selected="false">
                                                <i class="bi bi-trophy-fill text-orange me-2"></i>Glavni turnir
                                            </button>
                                        </li>
                                        }
                                        @if (razigravanjeMecevi.Any())
                                        {
                                            <li class="nav-item flex-shrink-0" role="presentation">
                                                <button class="nav-link text-white fw-bold py-3 px-4 rounded-3 text-nowrap" id="placement-tab" data-bs-toggle="pill" data-bs-target="#placement-pane" type="button" role="tab" aria-controls="placement-pane" aria-selected="false">
                                                    <i class="bi bi-diagram-3-fill text-orange me-2"></i>Razigravanje
                                                </button>
                                            </li>
                                        }
                                        @if (utjesniGlavniMecevi.Any())
                                        {
                                            <li class="nav-item flex-shrink-0" role="presentation">
                                                <button class="nav-link text-white fw-bold py-3 px-4 rounded-3 text-nowrap" id="consolation-tab" data-bs-toggle="pill" data-bs-target="#consolation-pane" type="button" role="tab" aria-controls="consolation-pane" aria-selected="false">
                                                    <i class="bi bi-patch-check-fill text-orange me-2"></i>Utješni turnir
                                                </button>
                                            </li>
                                        }
                                        @if (utjesniRazigravanjeMecevi.Any())
                                        {
                                            <li class="nav-item flex-shrink-0" role="presentation">
                                                <button class="nav-link text-white fw-bold py-3 px-4 rounded-3 text-nowrap" id="consolation-placement-tab" data-bs-toggle="pill" data-bs-target="#consolation-placement-pane" type="button" role="tab" aria-controls="consolation-placement-pane" aria-selected="false">
                                                    <i class="bi bi-diagram-3-fill text-orange me-2"></i>Razigravanje (Utješni)
                                                </button>
                                            </li>
                                        }
                                    }
                                    @if ((Model.Status == StatusTurnira.UToku || Model.Status == StatusTurnira.Zavrsen) && Model.TipTakmicenja != ePinPong.Models.TipTakmicenja.Singl)
                                    {
                                        bool isDublOnly = Model.TipTakmicenja == ePinPong.Models.TipTakmicenja.Dubl;
                                        <li class="nav-item flex-shrink-0" role="presentation">
                                            <button class="nav-link @(isDublOnly ? "active" : "") text-white fw-bold py-3 px-4 rounded-3 text-nowrap" id="doubles-tab" data-bs-toggle="pill" data-bs-target="#doubles-pane" type="button" role="tab" aria-controls="doubles-pane" aria-selected="@(isDublOnly ? "true" : "false")">
                                                <i class="bi bi-people-fill text-orange me-2"></i>Turnir Parova
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <button type="button" class="btn btn-dark border border-dark-glow text-orange rounded-3 px-3 py-3 shadow-sm d-flex align-items-center justify-content-center" id="scrollTabsRight" title="Skroluj skroz udesno" style="flex-shrink: 0;">
                                <i class="bi bi-chevron-right fs-5"></i>
                            </button>
                        </div>
                    }

                    <div class="tab-content" id="tournamentTabsContent">
                        <!-- Pane: Grupna faza -->
                        <div class="tab-pane fade show active" id="groups-pane" role="tabpanel" aria-labelledby="groups-tab" tabindex="0">
                            @{
                                var meceviPoGrupama = grupniMecevi.GroupBy(m => m.NazivGrupe).OrderBy(g => g.Key).ToList();
                            }
                            @if (!grupniMecevi.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-info-circle text-white-50 fs-2 mb-3"></i>
                                    <h5 class="text-white">Grupna faza još nije generisana</h5>
                                </div>
                            }
                            else
                            {
                                @foreach (var grupaGroup in meceviPoGrupama)
                                {
                                    var nazivGrupe = grupaGroup.Key ?? "Grupa";
                                    var meceviGrupe = grupaGroup.ToList();

                                    var igraciGrupeIds = meceviGrupe
                                        .SelectMany(m => new[] { m.Igrac1ID, m.Igrac2ID })
                                        .Where(id => id != null)
                                        .Distinct()
                                        .ToList();

                                    var records = new List<dynamic>();
                                    foreach (var igracId in igraciGrupeIds)
                                    {
                                        var igracName = "";
                                        var isGost = false;
                                        var grad = "";
                                        
                                        var mecSaIgracem = meceviGrupe.FirstOrDefault(m => m.Igrac1ID == igracId || m.Igrac2ID == igracId);
                                        if (mecSaIgracem != null)
                                        {
                                            var igrac = mecSaIgracem.Igrac1ID == igracId ? mecSaIgracem.Igrac1 : mecSaIgracem.Igrac2;
                                            if (igrac != null)
                                            {
                                                igracName = $"{igrac.Ime} {igrac.Prezime}";
                                                isGost = igrac.IsGost;
                                                grad = igrac.Grad;
                                            }
                                        }

                                        int pobjede = 0;
                                        int porazi = 0;
                                        int osvojeniSetovi = 0;
                                        int izgubljeniSetovi = 0;

                                        foreach (var m in meceviGrupe.Where(m => m.Odigran))
                                        {
                                            if (m.Igrac1ID == igracId)
                                            {
                                                osvojeniSetovi += m.PoeniIgrac1 ?? 0;
                                                izgubljeniSetovi += m.PoeniIgrac2 ?? 0;
                                                if ((m.PoeniIgrac1 ?? 0) > (m.PoeniIgrac2 ?? 0)) pobjede++;
                                                else porazi++;
                                            }
                                            else if (m.Igrac2ID == igracId)
                                            {
                                                osvojeniSetovi += m.PoeniIgrac2 ?? 0;
                                                izgubljeniSetovi += m.PoeniIgrac1 ?? 0;
                                                if ((m.PoeniIgrac2 ?? 0) > (m.PoeniIgrac1 ?? 0)) pobjede++;
                                                else porazi++;
                                            }
                                        }

                                        records.Add(new {
                                            PlayerID = igracId,
                                            ImePrezime = igracName,
                                            IsGost = isGost,
                                            Grad = grad,
                                            Pobjede = pobjede,
                                            Porazi = porazi,
                                            SetRazlika = osvojeniSetovi - izgubljeniSetovi,
                                            OsvojeniSetovi = osvojeniSetovi
                                        });
                                    }

                                    var sortiraniStandings = records
                                        .OrderByDescending(r => r.Pobjede)
                                        .ThenByDescending(r => r.SetRazlika)
                                        .ThenByDescending(r => r.OsvojeniSetovi)
                                        .ToList();

                                    <div class="mb-5 p-3 rounded-4 bg-dark-card border border-dark-glow shadow-sm">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h4 class="text-orange fw-bold mb-0"><i class="bi bi-table text-orange me-2"></i>@((isGroupOnly || isMasters) ? (nazivGrupe + " - Konačni plasman") : (nazivGrupe + " - Tabela i mečevi"))</h4>
                                            <button class="btn btn-outline-light-glow btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" type="button" data-bs-toggle="collapse" data-bs-target="#groupCollapse-@nazivGrupe.Replace(" ", "")" aria-expanded="true" aria-controls="groupCollapse-@nazivGrupe.Replace(" ", "")">
                                                <i class="bi bi-chevron-up toggle-chevron"></i>
                                            </button>
                                        </div>
                                        <div class="collapse show" id="groupCollapse-@nazivGrupe.Replace(" ", "")">
                                            <div class="table-responsive rounded-3 overflow-hidden border border-dark-glow mb-4">
                                            <table class="table table-dark table-striped align-middle mb-0 text-center">
                                                <thead>
                                                    <tr class="text-muted small border-bottom border-dark-glow">
                                                        <th style="width: 8%;">Poz</th>
                                                        <th class="text-start" style="width: 40%;">Igrač</th>
                                                        <th style="width: 13%;">Pobjede</th>
                                                        <th style="width: 13%;">Porazi</th>
                                                        <th style="width: 13%;">Set Razlika</th>
                                                        <th style="width: 13%;">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int idx = 0; idx < sortiraniStandings.Count; idx++)
                                                    {
                                                        var row = sortiraniStandings[idx];
                                                        var prolaz = idx < 2;
                                                        <tr class="@(prolaz ? "border-start border-3 border-success bg-success-transparent-row" : "")">
                                                            <td class="fw-bold @(idx == 0 ? "text-warning" : (idx == 1 ? "text-light" : "text-muted"))">@(idx + 1).</td>
                                                            <td class="text-start">
                                                                <a href="/Korisnik/Index/@row.PlayerID" class="text-white hover-orange fw-bold">
                                                                    @row.ImePrezime
                                                                    @if (row.IsGost)
                                                                    {
                                                                        <span class="badge bg-secondary text-muted ms-1" style="font-size: 0.75rem;">Gost</span>
                                                                    }
                                                                </a>
                                                                <small class="d-block text-muted" style="font-size: 0.75rem;">@row.Grad</small>
                                                            </td>
                                                            <td class="text-success fw-bold">@row.Pobjede</td>
                                                            <td class="text-danger fw-bold">@row.Porazi</td>
                                                            <td class="@(row.SetRazlika >= 0 ? "text-success" : "text-danger") fw-bold">
                                                                @(row.SetRazlika >= 0 ? "+" : "")@row.SetRazlika
                                                            </td>
                                                            <td>
                                                                @if (isGroupOnly || isMasters)
                                                                {
                                                                    string plasmanLabel = (idx + 1) switch
                                                                    {
                                                                        1 => "🏆 1. mjesto",
                                                                        2 => "🥈 2. mjesto",
                                                                        3 => "🥉 3. mjesto",
                                                                        _ => $"{idx + 1}. mjesto"
                                                                    };
                                                                    string badgeClass = (idx + 1) switch
                                                                    {
                                                                        1 => "bg-warning text-dark",
                                                                        2 => "bg-secondary text-white",
                                                                        3 => "bg-danger text-white",
                                                                        _ => "bg-dark-glow text-muted"
                                                                    };
                                                                    <span class="badge @badgeClass px-2 py-1 rounded-pill">@plasmanLabel</span>
                                                                }
                                                                else if (prolaz)
                                                                {
                                                                    <span class="badge bg-success text-white px-2 py-1 rounded-pill">Prolaz dalje</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-dark-glow text-muted px-2 py-1 rounded-pill">Eliminisan</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <h6 class="text-white fw-semibold mb-3"><i class="bi bi-controller text-orange me-2"></i>Mečevi u grupi</h6>
                                        <div class="row g-3">
                                            @foreach (var mec in meceviGrupe)
                                            {
                                                <div class="col-12">
                                                    <div class="match-card p-3 bg-dark-input border border-dark-glow rounded-3 d-flex align-items-center justify-content-between">
                                                        <div class="d-flex align-items-center flex-grow-1">
                                                            <div class="text-end flex-grow-1 pe-3">
                                                                @if (mec.Igrac1ID != null)
                                                                {
                                                                    @if (mec.Igrac1ID == "SLOBODAN")
                                                                    {
                                                                        <span class="text-white-50 small fst-italic">Slobodan</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a href="/Korisnik/Index/@mec.Igrac1ID" class="text-white hover-orange fw-semibold">
                                                                            @mec.Igrac1?.Ime @mec.Igrac1?.Prezime
                                                                            @if (mec.Igrac1 != null && mec.Igrac1.IsGost)
                                                                            {
                                                                                <span class="text-muted small">(Gost)</span>
                                                                            }
                                                                        </a>
                                                                    }
                                                                }
                                                            </div>

                                                            <div class="score-display px-3 py-1 rounded bg-dark border border-dark-glow text-center mx-2" style="min-width: 80px;">
                                                                @if (mec.Odigran)
                                                                {
                                                                    <span class="text-orange fw-bold fs-5">@mec.PoeniIgrac1 : @mec.PoeniIgrac2</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted font-monospace small">VS</span>
                                                                }
                                                            </div>

                                                            <div class="text-start flex-grow-1 ps-3">
                                                                @if (mec.Igrac2ID != null)
                                                                {
                                                                    @if (mec.Igrac2ID == "SLOBODAN")
                                                                    {
                                                                        <span class="text-white-50 small fst-italic">Slobodan</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a href="/Korisnik/Index/@mec.Igrac2ID" class="text-white hover-orange fw-semibold">
                                                                            @mec.Igrac2?.Ime @mec.Igrac2?.Prezime
                                                                            @if (mec.Igrac2 != null && mec.Igrac2.IsGost)
                                                                            {
                                                                                <span class="text-muted small">(Gost)</span>
                                                                            }
                                                                        </a>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>

                                                        @if (isOrganizator && mec.Igrac1ID != null && mec.Igrac2ID != null && mec.Igrac1ID != "SLOBODAN" && mec.Igrac2ID != "SLOBODAN")
                                                        {
                                                            <div class="ps-3 border-start border-secondary ms-3">
                                                                <button type="button" class="btn btn-outline-warning btn-sm fw-bold"
                                                                        data-bs-toggle="modal" data-bs-target="#unosRezultataModal"
                                                                        data-mec-id="@mec.ID"
                                                                        data-igrac1="@(mec.Igrac1?.Ime + " " + mec.Igrac1?.Prezime)"
                                                                        data-igrac1-partner="@(mec.Igrac1Partner != null ? mec.Igrac1Partner.Ime + " " + mec.Igrac1Partner.Prezime : "")"
                                                                        data-igrac2="@(mec.Igrac2?.Ime + " " + mec.Igrac2?.Prezime)"
                                                                        data-igrac2-partner="@(mec.Igrac2Partner != null ? mec.Igrac2Partner.Ime + " " + mec.Igrac2Partner.Prezime : "")"
                                                                        data-poeni1="@(mec.PoeniIgrac1 ?? 0)"
                                                                        data-poeni2="@(mec.PoeniIgrac2 ?? 0)"
                                                                        data-runda="@mec.Runda"
                                                                        data-grupa="@mec.NazivGrupe">
                                                                    <i class="bi bi-trophy-fill"></i> Unos
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        @if (!isMasters)
                        {
                        <!-- Pane: Glavni turnir -->
                        <div class="tab-pane fade" id="knockout-pane" role="tabpanel" aria-labelledby="knockout-tab" tabindex="0">
                            @{
                                var rundeZavrsnice = zavrsniMecevi.GroupBy(m => m.Runda).OrderBy(g => g.Key).ToList();
                            }
                            @if (!sviZavrsniMecevi.Any())
                            {
                                @if (isGroupOnly)
                                {
                                    <div class="text-center py-5">
                                        <i class="bi bi-grid-3x3-gap-fill text-orange fs-2 mb-3"></i>
                                        <h5 class="text-white fw-bold">Grupna faza je konačni plasman</h5>
                                        <p class="text-white-50 small mb-0">Ovaj turnir nema posebnu završnicu. Konačni poredak određen je rezultatima grupne faze.</p>
                                    </div>
                                }
                                else
                                {
                                <div class="text-center py-5">
                                    <i class="bi bi-trophy text-white-50 fs-2 mb-3"></i>
                                    <h5 class="text-white">Glavni turnir još nije generisan</h5>
                                    @if (isOrganizator && grupniMecevi.All(m => m.Odigran))
                                    {
                                        <p class="text-white-50 small mb-3">Grupna faza je uspješno završena. Generišite parove glavnog turnira kako biste nastavili turnir.</p>
                                        <form asp-controller="Mec" asp-action="GenerirajZavrsnicu" method="post">
                                            <input type="hidden" name="turnirId" value="@Model.ID" />
                                            <button type="submit" class="btn btn-orange text-white fw-bold"><i class="bi bi-lightning-fill me-2"></i>Generiši parove</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <p class="text-white-50 small mb-0">Parovi glavnog turnira će biti dostupni nakon što svi mečevi grupne faze budu odigrani.</p>
                                    }
                                </div>
                                }
                            }
                            else if (!zavrsniMecevi.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-info-circle text-white-50 fs-2 mb-3"></i>
                                    <h5 class="text-white">Nema mečeva glavnog turnira</h5>
                                    <p class="text-white-50 small mb-0">Mečevi glavnog turnira nisu dostupni.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var runda in rundeZavrsnice)
                                {
                                    var rNo = runda.Key;
                                    var rMatches = runda.ToList();
                                    var matchesCount = rMatches.Count;
                                    
                                    string rundaNaziv = $"KOLO {rNo}";
                                    if (matchesCount == 1)
                                    {
                                        rundaNaziv = "FINALE";
                                    }
                                    else if (matchesCount == 2)
                                    {
                                        rundaNaziv = "POLUFINALE";
                                    }
                                    else if (matchesCount == 4)
                                    {
                                        rundaNaziv = "ČETVRTFINALE";
                                    }
                                    else if (matchesCount == 8)
                                    {
                                        rundaNaziv = "OSMINA FINALA";
                                    }
                                    else if (matchesCount == 16)
                                    {
                                        rundaNaziv = "ŠESNAESTINA FINALA";
                                    }

                                    <div class="d-flex justify-content-between align-items-center border-bottom border-dark-glow pb-2 mb-3 mt-4">
                                        <h5 class="text-orange fw-bold mb-0 text-uppercase">@rundaNaziv</h5>
                                        <button class="btn btn-outline-light-glow btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" type="button" data-bs-toggle="collapse" data-bs-target="#roundCollapse-@rNo" aria-expanded="true" aria-controls="roundCollapse-@rNo">
                                            <i class="bi bi-chevron-up toggle-chevron" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="collapse show" id="roundCollapse-@rNo">
                                        <div class="row g-3">
                                        @foreach (var mec in rMatches)
                                        {
                                            <div class="col-12">
                                                <div class="match-card p-3 bg-dark-input border border-dark-glow rounded-3 d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center flex-grow-1">
                                                        <div class="text-end flex-grow-1 pe-3">
                                                            @if (mec.Igrac1ID != null)
                                                            {
                                                                <a href="/Korisnik/Index/@mec.Igrac1ID" class="text-white hover-orange fw-semibold">
                                                                    @mec.Igrac1?.Ime @mec.Igrac1?.Prezime
                                                                    @if (mec.Igrac1 != null && mec.Igrac1.IsGost)
                                                                    {
                                                                        <span class="text-muted small">(Gost)</span>
                                                                    }
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                if (rNo > 1)
                                                                {
                                                                    var mNo = int.Parse(mec.MatchCode.Split('_').Last().Substring(1));
                                                                    var srcMatchNo = 2 * mNo - 1;
                                                                    <span class="text-white-50 small text-uppercase italic">Pobjednik R@(rNo - 1) M@(srcMatchNo)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted small italic">Slobodan prolaz (BYE)</span>
                                                                }
                                                            }
                                                        </div>

