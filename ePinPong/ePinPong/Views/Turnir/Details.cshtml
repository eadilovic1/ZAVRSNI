                                                            }
                                                        </div>

                                                        <div class="score-display px-3 py-1 rounded bg-dark border @(isFinalni ? "border-orange" : "border-dark-glow") text-center mx-2" style="min-width: 80px;">
                                                            @if (plMec.Odigran)
                                                            {
                                                                <span class="@(isFinalni ? "text-orange" : "text-white") fw-bold fs-5">@plMec.PoeniIgrac1 : @plMec.PoeniIgrac2</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted font-monospace small">VS</span>
                                                            }
                                                        </div>

                                                        <div class="text-start flex-grow-1 ps-3">
                                                            @if (plMec.Igrac2ID != null)
                                                            {
                                                                @if (plMec.Igrac2ID == "SLOBODAN")
                                                                {
                                                                    <span class="text-white-50 small fst-italic">Slobodan</span>
                                                                }
                                                                else
                                                                {
                                                                    <a href="/Korisnik/Index/@plMec.Igrac2ID" class="text-white hover-orange fw-semibold">
                                                                        @plMec.Igrac2?.Ime @plMec.Igrac2?.Prezime
                                                                        @if (plMec.Igrac2 != null && plMec.Igrac2.IsGost)
                                                                        {
                                                                            <span class="text-muted small">(Gost)</span>
                                                                        }
                                                                    </a>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="text-white-50 small italic">Čeka se protivnik</span>
                                                            }
                                                        </div>
                                                    </div>

                                                    @if (isOrganizator && plMec.Igrac1ID != null && plMec.Igrac2ID != null && plMec.Igrac1ID != "SLOBODAN" && plMec.Igrac2ID != "SLOBODAN")
                                                    {
                                                        <div class="ps-3 border-start border-secondary ms-3">
                                                            <button type="button" class="btn btn-outline-warning btn-sm fw-bold"
                                                                    data-bs-toggle="modal" data-bs-target="#unosRezultataModal"
                                                                    data-mec-id="@plMec.ID"
                                                                    data-igrac1="@(plMec.Igrac1?.Ime + " " + plMec.Igrac1?.Prezime)"
                                                                    data-igrac1-partner="@(plMec.Igrac1Partner != null ? plMec.Igrac1Partner.Ime + " " + plMec.Igrac1Partner.Prezime : "")"
                                                                    data-igrac2="@(plMec.Igrac2?.Ime + " " + plMec.Igrac2?.Prezime)"
                                                                    data-igrac2-partner="@(plMec.Igrac2Partner != null ? plMec.Igrac2Partner.Ime + " " + plMec.Igrac2Partner.Prezime : "")"
                                                                    data-poeni1="@(plMec.PoeniIgrac1 ?? 0)"
                                                                    data-poeni2="@(plMec.PoeniIgrac2 ?? 0)"
                                                                    data-runda="@plMec.Runda"
                                                                    data-grupa="@plMec.NazivGrupe">
                                                                <i class="bi bi-trophy-fill"></i> Unos
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        }

                        <!-- Pane: Turnir Parova -->
                        @if (Model.Status == StatusTurnira.UToku || Model.Status == StatusTurnira.Zavrsen)
                        {
                        <div class="tab-pane fade" id="doubles-pane" role="tabpanel" aria-labelledby="doubles-tab" tabindex="0">
                            @{
                                var paroviMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.TurnirParova).ToList();
                                var rundeParova = paroviMecevi.GroupBy(m => m.Runda).OrderBy(g => g.Key).ToList();
                                bool isParoviGrupa = paroviMecevi.Any(m => !string.IsNullOrEmpty(m.NazivGrupe));

                                var maxRundaParova = rundeParova.Any() ? rundeParova.Max(g => g.Key) : 0;
                                var finalniMecParova = paroviMecevi.FirstOrDefault(m => m.Runda == maxRundaParova);

                                bool paroviZavrseni = false;

                                (ApplicationUser? Igrac1, ApplicationUser? Igrac2)? prvoMjesto = null;
                                (ApplicationUser? Igrac1, ApplicationUser? Igrac2)? drugoMjesto = null;
                                var trecaMjesta = new List<(ApplicationUser? Igrac1, ApplicationUser? Igrac2)>();

                                var paroviStandingsMap = new Dictionary<string, List<dynamic>>();

                                if (isParoviGrupa)
                                {
                                    paroviZavrseni = paroviMecevi.Count > 0 && paroviMecevi.All(m => m.Odigran);

                                    var meceviPoGrupamaParova = paroviMecevi.GroupBy(m => m.NazivGrupe).OrderBy(g => g.Key).ToList();
                                    foreach (var grupaGroup in meceviPoGrupamaParova)
                                    {
                                        string gName = grupaGroup.Key ?? "Grupa A (Parovi)";
                                        var meceviGrupe = grupaGroup.ToList();

                                        var paroviSet = new List<(string I1Id, string I2Id, ApplicationUser? I1, ApplicationUser? I2)>();
                                        foreach (var p in Model.TurnirParovi)
                                        {
                                            if (p.Igrac1ID != null && p.Igrac2ID != null)
                                            {
                                                if (!paroviSet.Any(x => (x.I1Id == p.Igrac1ID && x.I2Id == p.Igrac2ID) || (x.I1Id == p.Igrac2ID && x.I2Id == p.Igrac1ID)))
                                                {
                                                    paroviSet.Add((p.Igrac1ID, p.Igrac2ID, p.Igrac1, p.Igrac2));
                                                }
                                            }
                                        }
                                        foreach (var m in meceviGrupe)
                                        {
                                            if (m.Igrac1ID != null && m.Igrac1PartnerID != null)
                                            {
                                                if (!paroviSet.Any(x => (x.I1Id == m.Igrac1ID && x.I2Id == m.Igrac1PartnerID) || (x.I1Id == m.Igrac1PartnerID && x.I2Id == m.Igrac1ID)))
                                                {
                                                    paroviSet.Add((m.Igrac1ID, m.Igrac1PartnerID, m.Igrac1, m.Igrac1Partner));
                                                }
                                            }
                                            if (m.Igrac2ID != null && m.Igrac2PartnerID != null)
                                            {
                                                if (!paroviSet.Any(x => (x.I1Id == m.Igrac2ID && x.I2Id == m.Igrac2PartnerID) || (x.I1Id == m.Igrac2PartnerID && x.I2Id == m.Igrac2ID)))
                                                {
                                                    paroviSet.Add((m.Igrac2ID, m.Igrac2PartnerID, m.Igrac2, m.Igrac2Partner));
                                                }
                                            }
                                        }

                                        var records = new List<dynamic>();
                                        foreach (var pTuple in paroviSet)
                                        {
                                            int pobjede = 0;
                                            int porazi = 0;
                                            int osvojeniSetovi = 0;
                                            int izgubljeniSetovi = 0;

                                            foreach (var m in meceviGrupe.Where(m => m.Odigran))
                                            {
                                                bool isSide1 = (m.Igrac1ID == pTuple.I1Id && m.Igrac1PartnerID == pTuple.I2Id) || (m.Igrac1ID == pTuple.I2Id && m.Igrac1PartnerID == pTuple.I1Id);
                                                bool isSide2 = (m.Igrac2ID == pTuple.I1Id && m.Igrac2PartnerID == pTuple.I2Id) || (m.Igrac2ID == pTuple.I2Id && m.Igrac2PartnerID == pTuple.I1Id);

                                                if (isSide1)
                                                {
                                                    int p1 = m.PoeniIgrac1 ?? 0;
                                                    int p2 = m.PoeniIgrac2 ?? 0;
                                                    osvojeniSetovi += p1;
                                                    izgubljeniSetovi += p2;
                                                    if (p1 > p2) pobjede++; else porazi++;
                                                }
                                                else if (isSide2)
                                                {
                                                    int p1 = m.PoeniIgrac1 ?? 0;
                                                    int p2 = m.PoeniIgrac2 ?? 0;
                                                    osvojeniSetovi += p2;
                                                    izgubljeniSetovi += p1;
                                                    if (p2 > p1) pobjede++; else porazi++;
                                                }
                                            }

                                            records.Add(new {
                                                Igrac1ID = pTuple.I1Id,
                                                Igrac2ID = pTuple.I2Id,
                                                Igrac1 = pTuple.I1,
                                                Igrac2 = pTuple.I2,
                                                Pobjede = pobjede,
                                                Porazi = porazi,
                                                SetRazlika = osvojeniSetovi - izgubljeniSetovi,
                                                OsvojeniSetovi = osvojeniSetovi
                                            });
                                        }

                                        var sortirani = records
                                            .OrderByDescending(r => r.Pobjede)
                                            .ThenByDescending(r => r.SetRazlika)
                                            .ThenByDescending(r => r.OsvojeniSetovi)
                                            .ToList();

                                        paroviStandingsMap[gName] = sortirani;

                                        if (paroviZavrseni)
                                        {
                                            if (sortirani.Count > 0) prvoMjesto = (sortirani[0].Igrac1, sortirani[0].Igrac2);
                                            if (sortirani.Count > 1) drugoMjesto = (sortirani[1].Igrac1, sortirani[1].Igrac2);
                                            if (sortirani.Count > 2) trecaMjesta.Add((sortirani[2].Igrac1, sortirani[2].Igrac2));
                                        }
                                    }
                                }
                                else
                                {
                                    paroviZavrseni = finalniMecParova != null && finalniMecParova.Odigran;
                                    if (paroviZavrseni && finalniMecParova != null)
                                    {
                                        bool isIgrac1Pobjednik = (finalniMecParova.PoeniIgrac1 ?? 0) > (finalniMecParova.PoeniIgrac2 ?? 0);
                                        if (isIgrac1Pobjednik)
                                        {
                                            prvoMjesto = (finalniMecParova.Igrac1, finalniMecParova.Igrac1Partner);
                                            drugoMjesto = (finalniMecParova.Igrac2, finalniMecParova.Igrac2Partner);
                                        }
                                        else
                                        {
                                            prvoMjesto = (finalniMecParova.Igrac2, finalniMecParova.Igrac2Partner);
                                            drugoMjesto = (finalniMecParova.Igrac1, finalniMecParova.Igrac1Partner);
                                        }

                                        if (maxRundaParova > 1)
                                        {
                                            var polufinalniMecevi = paroviMecevi.Where(m => m.Runda == maxRundaParova - 1).ToList();
                                            foreach (var pfMec in polufinalniMecevi)
                                            {
                                                if (pfMec.Odigran)
                                                {
                                                    bool pfIgrac1Pobjednik = (pfMec.PoeniIgrac1 ?? 0) > (pfMec.PoeniIgrac2 ?? 0);
                                                    if (pfIgrac1Pobjednik)
                                                    {
                                                        if (pfMec.Igrac2ID != null)
                                                        {
                                                            trecaMjesta.Add((pfMec.Igrac2, pfMec.Igrac2Partner));
                                                        }
                                                    }
                                                    else
                                                    {
                                                        if (pfMec.Igrac1ID != null)
                                                        {
                                                            trecaMjesta.Add((pfMec.Igrac1, pfMec.Igrac1Partner));
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            @if (!paroviMecevi.Any())
                            {
                                <div class="row">
                                    <!-- List of registered pairs -->
                                    <div class="col-12 col-md-7 mb-4">
                                        <div class="p-4 bg-dark-input border border-dark-glow rounded-4">
                                            <h5 class="text-white fw-bold mb-3"><i class="bi bi-people-fill text-orange me-2"></i>Prijavljeni parovi (@Model.TurnirParovi.Count)</h5>
                                            @if (!Model.TurnirParovi.Any())
                                            {
                                                <p class="text-white-50 small mb-0">Nema registrovanih parova za ovaj turnir.</p>
                                            }
                                            else
                                            {
                                                <div class="row g-2">
                                                    @foreach (var par in Model.TurnirParovi)
                                                    {
                                                        <div class="col-12 col-sm-6">
                                                            <div class="p-3 bg-dark-card border border-dark-glow rounded-3 d-flex justify-content-between align-items-center">
                                                                <div class="text-truncate">
                                                                    <span class="text-white fw-semibold">@par.Igrac1?.Ime @par.Igrac1?.Prezime</span>
                                                                    <span class="text-muted d-block text-truncate" style="font-size:0.85rem;">/ @par.Igrac2?.Ime @par.Igrac2?.Prezime</span>
                                                                </div>
                                                                @{
                                                                    var isUserInThisPair = par.Igrac1ID == currentUserId || par.Igrac2ID == currentUserId;
                                                                    var canDeletePair = (isOrganizator || isUserInThisPair) && !Model.Mecevi.Any(m => m.TipMeca == TipMeca.TurnirParova);
                                                                }
                                                                @if (canDeletePair)
                                                                {
                                                                    <form asp-controller="Turnir" asp-action="UkloniPar" method="post" class="d-inline" onsubmit="sessionStorage.setItem('turnirScrollY', window.scrollY); return confirm('Da li ste sigurni da želite ukloniti ovaj par sa turnira?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="turnirId" value="@Model.ID" />
                                                                        <input type="hidden" name="parId" value="@par.ID" />
                                                                        <button type="submit" class="btn btn-outline-danger btn-sm p-1 rounded-circle ms-2"
                                                                            style="width:28px; height:28px;" title="Ukloni par">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Forms to add pairs / generator -->
                                    <div class="col-12 col-md-5 mb-4">
                                        @{
                                            var pairedUserIds = Model.TurnirParovi.SelectMany(p => new[] { p.Igrac1ID, p.Igrac2ID }).Distinct().ToList();
                                            var slobodniIgraciZaPar = Model.Registracije
                                                .Where(r => !pairedUserIds.Contains(r.KorisnikID))
                                                .Select(r => r.Korisnik)
                                                .ToList();
                                            var isUserRegistered = Model.Registracije.Any(r => r.KorisnikID == currentUserId);
                                            var isUserPaired = Model.TurnirParovi.Any(p => p.Igrac1ID == currentUserId || p.Igrac2ID == currentUserId);
                                        }

                                        @if (isUserRegistered && !isUserPaired)
                                        {
                                            <div class="p-4 bg-dark-input border border-dark-glow rounded-4 mb-4" id="prijava-par-scroll">
                                                <h5 class="text-white fw-bold mb-3"><i class="bi bi-person-plus-fill text-orange me-2"></i>Prijavi svoj par</h5>
                                                <form asp-controller="Turnir" asp-action="PrijaviPar" method="post" id="formPrijaviPar">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="turnirId" value="@Model.ID" />
                                                    <div class="mb-3">
                                                        <label class="form-label text-white-50 small">Izaberi partnera</label>
                                                        <select name="partnerId" class="form-select bg-dark border-dark-glow text-white text-uppercase" required>
                                                            <option value="">-- Izaberi igrača --</option>
                                                            @foreach (var igrac in slobodniIgraciZaPar.Where(u => u != null && u.Id != currentUserId))
                                                            {
                                                                <option value="@igrac!.Id">@igrac.Ime @igrac.Prezime (@igrac.Grad)</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <button type="submit" class="btn btn-orange btn-sm text-white fw-bold w-100">Potvrdi prijavu</button>
                                                </form>
                                            </div>
                                        }
                                        else if (isUserRegistered && isUserPaired)
                                        {
                                            var myPair = Model.TurnirParovi.FirstOrDefault(p => p.Igrac1ID == currentUserId || p.Igrac2ID == currentUserId);
                                            var partner = myPair?.Igrac1ID == currentUserId ? myPair?.Igrac2 : myPair?.Igrac1;
                                            var imaMeceveParova = Model.Mecevi.Any(m => m.TipMeca == TipMeca.TurnirParova);

                                            <div class="p-4 bg-dark-input border border-dark-glow rounded-4 mb-4" id="prijava-par-scroll">
                                                <h5 class="text-white fw-bold mb-2"><i class="bi bi-people-fill text-orange me-2"></i>Tvoj par</h5>
                                                <p class="text-white-50 small mb-3">Prijavljeni ste sa: <strong class="text-white">@partner?.Ime @partner?.Prezime</strong></p>
                                                @if (!imaMeceveParova && myPair != null)
                                                {
                                                    <form asp-controller="Turnir" asp-action="UkloniPar" method="post" onsubmit="sessionStorage.setItem('turnirScrollY', window.scrollY); return confirm('Da li ste sigurni da želite odjaviti svoj par sa turnira?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="turnirId" value="@Model.ID" />
                                                        <input type="hidden" name="parId" value="@myPair.ID" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm text-white fw-bold w-100">
                                                            <i class="bi bi-person-x-fill me-1"></i> Odjavi svoj par
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-secondary mb-0 small text-white-50 py-2">
                                                        <i class="bi bi-info-circle me-1"></i> Mečevi parova su generisani. Odjava više nije moguća.
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (isOrganizator)
                                        {
                                            <div class="p-4 bg-dark-input border border-dark-glow rounded-4 mb-4">
                                                <h5 class="text-white fw-bold mb-3"><i class="bi bi-magic text-orange me-2"></i>Formiraj par (Admin)</h5>
                                                <form asp-controller="Turnir" asp-action="DodajParAdmin" method="post" id="formDodajParAdmin">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="turnirId" value="@Model.ID" />
                                                    <div class="mb-2">
                                                        <label class="form-label text-white-50 small">Igrač 1</label>
                                                        <select name="igrac1Id" id="adminParIgrac1" class="form-select bg-dark border-dark-glow text-white form-select-sm" required>
                                                            <option value="">-- Izaberi igrača --</option>
                                                            @foreach (var igrac in slobodniIgraciZaPar.Where(u => u != null))
                                                            {
                                                                <option value="@igrac!.Id">@igrac.Ime @igrac.Prezime (@igrac.Grad)</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label text-white-50 small">Igrač 2</label>
                                                        <select name="igrac2Id" id="adminParIgrac2" class="form-select bg-dark border-dark-glow text-white form-select-sm" required>
                                                            <option value="">-- Izaberi igrača --</option>
                                                            @foreach (var igrac in slobodniIgraciZaPar.Where(u => u != null))
                                                            {
                                                                <option value="@igrac!.Id">@igrac.Ime @igrac.Prezime (@igrac.Grad)</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <button type="submit" class="btn btn-outline-warning btn-sm fw-bold w-100"><i class="bi bi-plus-lg"></i> Formiraj par</button>
                                                </form>
                                            </div>

                                            <div class="p-4 bg-dark-input border border-orange rounded-4 text-center">
                                                <h5 class="text-white fw-bold mb-2"><i class="bi bi-lightning-fill text-orange"></i> Generisanje mečeva</h5>
                                                <p class="text-white-50 small mb-3">Za generisanje mečeva parova potrebna su najmanje 2 para, a mečevi se mogu generisati **tek po završetku glavnog turnira**.</p>
                                                
                                                @if (Model.Status == StatusTurnira.Zavrsen)
                                                {
                                                    <form asp-controller="Mec" asp-action="GenerirajTurnirParova" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="turnirId" value="@Model.ID" />
                                                        <button type="submit" class="btn btn-orange text-white fw-bold w-100" @(Model.TurnirParovi.Count < 2 ? "disabled" : "")><i class="bi bi-play-fill me-1"></i> Generiši Turnir Parova</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-secondary text-white fw-bold w-100" disabled><i class="bi bi-lock-fill me-1"></i> Čeka se kraj glavnog turnira</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (isOrganizator)
                                {
                                    <div class="d-flex justify-content-end mb-4">
                                        <form asp-controller="Mec" asp-action="GenerirajTurnirParova" method="post" onsubmit="return confirm('Da li ste sigurni? Ovo će obrisati sve trenutne mečeve parova i njihove rezultate.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="turnirId" value="@Model.ID" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm fw-bold"><i class="bi bi-arrow-counterclockwise"></i> Ponovo generiši parove</button>
                                        </form>
                                    </div>
                                }

                                @if (paroviZavrseni && prvoMjesto.HasValue)
                                {
                                    <div class="podium-section mb-4 p-4 rounded-4 bg-dark-card border border-dark-glow shadow-lg position-relative overflow-hidden">
                                        <div class="text-center mb-4">
                                            <h4 class="fw-bold text-orange text-uppercase mb-1">
                                                <i class="bi bi-trophy-fill text-warning me-2"></i>Konačni Plasman - Turnir Parova
                                            </h4>
                                            <p class="text-white-50 small mb-0">Postolje pobjednika turnira parova</p>
                                        </div>

                                        <div class="row g-3 align-items-stretch justify-content-center">
                                            <!-- 2. Mjesto (Srebro) -->
                                            @if (drugoMjesto.HasValue && drugoMjesto.Value.Igrac1 != null)
                                            {
                                                <div class="col-12 col-md-4 order-2 order-md-1">
                                                    <div class="p-3 rounded-4 bg-dark-input border border-secondary text-center position-relative h-100 d-flex flex-column justify-content-between">
                                                        <div class="badge bg-secondary text-white position-absolute top-0 start-50 translate-middle px-3 py-1 rounded-pill fw-bold">
                                                            🥈 2. Mjesto
                                                        </div>
                                                        <div class="pt-3 pb-2">
                                                            <i class="bi bi-award-fill text-secondary fs-1 mb-2 d-block"></i>
                                                            <h6 class="text-white fw-bold mb-1">@drugoMjesto.Value.Igrac1?.Ime @drugoMjesto.Value.Igrac1?.Prezime</h6>
                                                            <h6 class="text-white-50 fw-bold mb-0">/ @drugoMjesto.Value.Igrac2?.Ime @drugoMjesto.Value.Igrac2?.Prezime</h6>
                                                        </div>
                                                        <div class="mt-2 text-secondary small fw-semibold">2. MJESTO</div>
                                                    </div>
                                                </div>
                                            }

                                            <!-- 1. Mjesto (Zlato - Pobjednici) -->
                                            @if (prvoMjesto.HasValue && prvoMjesto.Value.Igrac1 != null)
                                            {
                                                <div class="col-12 col-md-4 order-1 order-md-2 mb-3 mb-md-0">
                                                    <div class="p-4 rounded-4 bg-dark-input border border-warning text-center position-relative h-100 d-flex flex-column justify-content-between shadow-glow" style="border-width: 2px !important;">
                                                        <div class="badge bg-warning text-dark position-absolute top-0 start-50 translate-middle px-4 py-2 rounded-pill fw-bold fs-6">
                                                            🥇 1. Mjesto (POBJEDNICI)
                                                        </div>
                                                        <div class="pt-3 pb-2">
                                                            <i class="bi bi-trophy-fill text-warning display-4 mb-2 d-block"></i>
                                                            <h5 class="text-white fw-bold mb-1">@prvoMjesto.Value.Igrac1?.Ime @prvoMjesto.Value.Igrac1?.Prezime</h5>
                                                            <h5 class="text-warning fw-bold mb-0">/ @prvoMjesto.Value.Igrac2?.Ime @prvoMjesto.Value.Igrac2?.Prezime</h5>
                                                        </div>
                                                        <div class="mt-2 text-warning small fw-bold">ŠAMPIONI TURNIRA PAROVA</div>
                                                    </div>
                                                </div>
                                            }

                                            <!-- 3. Mjesta (Bronza) -->
                                            @if (trecaMjesta.Any())
                                            {
                                                <div class="col-12 col-md-4 order-3">
                                                    <div class="p-3 rounded-4 bg-dark-input border text-center position-relative h-100 d-flex flex-column justify-content-between" style="border-color: #cd7f32 !important;">
                                                        <div class="badge text-white position-absolute top-0 start-50 translate-middle px-3 py-1 rounded-pill fw-bold" style="background-color: #cd7f32;">
                                                            🥉 @(trecaMjesta.Count > 1 ? "3. Mjesta" : "3. Mjesto")
                                                        </div>
                                                        <div class="pt-3 pb-2">
                                                            <i class="bi bi-award-fill fs-1 mb-2 d-block" style="color: #cd7f32;"></i>
                                                            @foreach (var par in trecaMjesta)
                                                            {
                                                                <div class="mb-2 pb-2 @(par != trecaMjesta.Last() ? "border-bottom border-dark-glow" : "")">
                                                                    <span class="text-white fw-bold d-block">@par.Igrac1?.Ime @par.Igrac1?.Prezime</span>
                                                                    <span class="text-white-50 small d-block">/ @par.Igrac2?.Ime @par.Igrac2?.Prezime</span>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="mt-1 small fw-semibold" style="color: #cd7f32;">@(trecaMjesta.Count > 1 ? "POLUFINALISTI" : "3. MJESTO")</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (isParoviGrupa)
                                {
                                    var meceviPoGrupamaParova = paroviMecevi.GroupBy(m => m.NazivGrupe).OrderBy(g => g.Key).ToList();
                                    @foreach (var grupaGroup in meceviPoGrupamaParova)
                                    {
                                        var nazivGrupe = grupaGroup.Key ?? "Grupa";
                                        var meceviGrupe = grupaGroup.ToList();
                                        var sortiraniStandings = paroviStandingsMap.ContainsKey(nazivGrupe) ? paroviStandingsMap[nazivGrupe] : new List<dynamic>();

                                        <div class="mb-5 p-3 rounded-4 bg-dark-card border border-dark-glow shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h4 class="text-orange fw-bold mb-0"><i class="bi bi-table text-orange me-2"></i>@nazivGrupe - Tabela i mečevi</h4>
                                                <button class="btn btn-outline-light-glow btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" type="button" data-bs-toggle="collapse" data-bs-target="#groupCollapsePar-@nazivGrupe.Replace(" ", "").Replace("(", "").Replace(")", "")" aria-expanded="true" aria-controls="groupCollapsePar-@nazivGrupe.Replace(" ", "").Replace("(", "").Replace(")", "")">
                                                    <i class="bi bi-chevron-up toggle-chevron"></i>
                                                </button>
                                            </div>
                                            <div class="collapse show" id="groupCollapsePar-@nazivGrupe.Replace(" ", "").Replace("(", "").Replace(")", "")">
                                                <div class="table-responsive rounded-3 overflow-hidden border border-dark-glow mb-4">
                                                    <table class="table table-dark table-striped align-middle mb-0 text-center">
                                                        <thead>
                                                            <tr class="text-muted small border-bottom border-dark-glow">
                                                                <th style="width: 8%;">Poz</th>
                                                                <th class="text-start" style="width: 40%;">Par</th>
                                                                <th style="width: 13%;">Pobjede</th>
                                                                <th style="width: 13%;">Porazi</th>
                                                                <th style="width: 13%;">Set Razlika</th>
                                                                <th style="width: 13%;">@(isGroupOnly ? "Plasman" : "Status")</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @for (int idx = 0; idx < sortiraniStandings.Count; idx++)
                                                            {
                                                                var row = sortiraniStandings[idx];
                                                                var isFirst = idx == 0;
                                                                var isSecond = idx == 1;
                                                                var isThird = idx == 2;
                                                                <tr class="@(paroviZavrseni ? (isFirst ? "border-start border-3 border-warning bg-warning-transparent-row" : (isSecond ? "border-start border-3 border-secondary" : "")) : "")">
                                                                    <td class="fw-bold @(idx == 0 ? "text-warning" : (idx == 1 ? "text-light" : "text-muted"))">@(idx + 1).</td>
                                                                    <td class="text-start">
                                                                        <span class="text-white fw-bold">
                                                                            @row.Igrac1?.Ime @row.Igrac1?.Prezime
                                                                        </span>
                                                                        <span class="text-muted fw-bold d-block small">
                                                                            / @row.Igrac2?.Ime @row.Igrac2?.Prezime
                                                                        </span>
                                                                    </td>
                                                                    <td class="text-success fw-bold">@row.Pobjede</td>
                                                                    <td class="text-danger fw-bold">@row.Porazi</td>
                                                                    <td class="@(row.SetRazlika >= 0 ? "text-success" : "text-danger") fw-bold">
                                                                        @(row.SetRazlika >= 0 ? "+" : "")@row.SetRazlika
                                                                    </td>
                                                                    <td>
                                                                        @if (paroviZavrseni)
                                                                        {
                                                                            if (isFirst)
                                                                            {
                                                                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold">🥇 1. Mjesto</span>
                                                                            }
                                                                            else if (isSecond)
                                                                            {
                                                                                <span class="badge bg-secondary text-white px-2 py-1 rounded-pill fw-bold">🥈 2. Mjesto</span>
                                                                            }
                                                                            else if (isThird)
                                                                            {
                                                                                <span class="badge text-white px-2 py-1 rounded-pill fw-bold" style="background-color: #cd7f32;">🥉 3. Mjesto</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="badge bg-dark-glow text-muted px-2 py-1 rounded-pill">Kraj</span>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-dark-glow text-muted px-2 py-1 rounded-pill">U toku</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <h6 class="text-white fw-semibold mb-3"><i class="bi bi-controller text-orange me-2"></i>Mečevi u grupi</h6>
                                                <div class="row g-3">
                                                    @foreach (var mec in meceviGrupe)
                                                    {
                                                        <div class="col-12">
                                                            <div class="match-card p-3 bg-dark-input border border-dark-glow rounded-3 d-flex align-items-center justify-content-between">
                                                                <div class="d-flex align-items-center flex-grow-1">
                                                                    <!-- Side 1 -->
                                                                    <div class="text-end flex-grow-1 pe-3">
                                                                        <span class="text-white fw-semibold">
                                                                            @mec.Igrac1?.Ime @mec.Igrac1?.Prezime
                                                                            @if (mec.Igrac1PartnerID != null)
                                                                            {
                                                                                <span class="text-muted d-block small">/ @mec.Igrac1Partner?.Ime @mec.Igrac1Partner?.Prezime</span>
                                                                            }
                                                                        </span>
                                                                    </div>

                                                                    <!-- Score -->
                                                                    <div class="score-display px-3 py-1 rounded bg-dark border border-dark-glow text-center mx-2" style="min-width: 80px;">
                                                                        @if (mec.Odigran)
                                                                        {
                                                                            <span class="text-orange fw-bold fs-5">@mec.PoeniIgrac1 : @mec.PoeniIgrac2</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted font-monospace small">VS</span>
                                                                        }
                                                                    </div>

                                                                    <!-- Side 2 -->
                                                                    <div class="text-start flex-grow-1 ps-3">
                                                                        <span class="text-white fw-semibold">
                                                                            @mec.Igrac2?.Ime @mec.Igrac2?.Prezime
                                                                            @if (mec.Igrac2PartnerID != null)
                                                                            {
                                                                                <span class="text-muted d-block small">/ @mec.Igrac2Partner?.Ime @mec.Igrac2Partner?.Prezime</span>
                                                                            }
                                                                        </span>
                                                                    </div>
                                                                </div>

                                                                <!-- Action -->
                                                                @if (isOrganizator && mec.Igrac1ID != null && mec.Igrac2ID != null && mec.Igrac1ID != "SLOBODAN" && mec.Igrac2ID != "SLOBODAN")
                                                                {
                                                                    <div class="ps-3 border-start border-secondary ms-3">
                                                                        <button type="button" class="btn btn-outline-warning btn-sm fw-bold"
                                                                                data-bs-toggle="modal" data-bs-target="#unosRezultataModal"
                                                                                data-mec-id="@mec.ID"
                                                                                data-igrac1="@(mec.Igrac1?.Ime + " " + mec.Igrac1?.Prezime)"
                                                                                data-igrac1-partner="@(mec.Igrac1Partner != null ? mec.Igrac1Partner.Ime + " " + mec.Igrac1Partner.Prezime : "")"
                                                                                data-igrac2="@(mec.Igrac2?.Ime + " " + mec.Igrac2?.Prezime)"
                                                                                data-igrac2-partner="@(mec.Igrac2Partner != null ? mec.Igrac2Partner.Ime + " " + mec.Igrac2Partner.Prezime : "")"
                                                                                data-poeni1="@(mec.PoeniIgrac1 ?? 0)"
                                                                                data-poeni2="@(mec.PoeniIgrac2 ?? 0)"
                                                                                data-runda="@mec.Runda"
                                                                                data-grupa="@mec.NazivGrupe">
                                                                            <i class="bi bi-trophy-fill"></i> Unos
                                                                        </button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <!-- Knockout bracket view -->
                                    @foreach (var runda in rundeParova)
                                    {
                                        var rNo = runda.Key;
                                        var rMatches = runda.ToList();
                                        var matchesCount = rMatches.Count;

                                        string rundaNaziv = $"KOLO {rNo}";
                                        if (matchesCount == 1) rundaNaziv = "FINALE";
                                        else if (matchesCount == 2) rundaNaziv = "POLUFINALE";
                                        else if (matchesCount == 4) rundaNaziv = "ČETVRTFINALE";
                                        else if (matchesCount == 8) rundaNaziv = "OSMINA FINALA";

                                        <div class="d-flex justify-content-between align-items-center border-bottom border-dark-glow pb-2 mb-3 mt-4">
                                            <h5 class="text-orange fw-bold mb-0 text-uppercase">@rundaNaziv</h5>
                                            <button class="btn btn-outline-light-glow btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" type="button" data-bs-toggle="collapse" data-bs-target="#roundCollapsePar-@rNo" aria-expanded="true" aria-controls="roundCollapsePar-@rNo">
                                                <i class="bi bi-chevron-up toggle-chevron" style="font-size: 0.75rem;"></i>
                                            </button>
                                        </div>

                                        <div class="collapse show" id="roundCollapsePar-@rNo">
                                            <div class="row g-3">
                                                @foreach (var mec in rMatches)
                                                {
                                                    <div class="col-12">
                                                        <div class="match-card p-3 bg-dark-input border border-dark-glow rounded-3 d-flex align-items-center justify-content-between">
                                                            <div class="d-flex align-items-center flex-grow-1">
                                                                <!-- Side 1 -->
                                                                <div class="text-end flex-grow-1 pe-3">
                                                                    @if (mec.Igrac1ID != null)
                                                                    {
                                                                        @if (mec.Igrac1ID == "SLOBODAN")
                                                                        {
                                                                            <span class="text-white-50 small fst-italic">Slobodan</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-white fw-semibold">
                                                                                @mec.Igrac1?.Ime @mec.Igrac1?.Prezime
                                                                                @if (mec.Igrac1PartnerID != null)
                                                                                {
                                                                                    <span class="text-muted d-block small">/ @mec.Igrac1Partner?.Ime @mec.Igrac1Partner?.Prezime</span>
                                                                                }
                                                                            </span>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        if (rNo > 1)
                                                                        {
                                                                            var mNo = int.Parse(mec.MatchCode.Split('_').Last().Substring(1));
                                                                            var srcMatchNo = 2 * mNo - 1;
                                                                            <span class="text-white-50 small text-uppercase italic">Pobjednik R@(rNo - 1) M@(srcMatchNo)</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted small italic">Slobodan prolaz (BYE)</span>
                                                                        }
                                                                    }
                                                                </div>

                                                                <!-- Score -->
                                                                <div class="score-display px-3 py-1 rounded bg-dark border border-dark-glow text-center mx-2" style="min-width: 80px;">
                                                                    @if (mec.Odigran)
                                                                    {
                                                                        <span class="text-orange fw-bold fs-5">@mec.PoeniIgrac1 : @mec.PoeniIgrac2</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted font-monospace small">VS</span>
                                                                    }
                                                                </div>

                                                                <!-- Side 2 -->
                                                                <div class="text-start flex-grow-1 ps-3">
                                                                    @if (mec.Igrac2ID != null)
                                                                    {
                                                                        @if (mec.Igrac2ID == "SLOBODAN")
                                                                        {
                                                                            <span class="text-white-50 small fst-italic">Slobodan</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-white fw-semibold">
                                                                                @mec.Igrac2?.Ime @mec.Igrac2?.Prezime
                                                                                @if (mec.Igrac2PartnerID != null)
                                                                                {
                                                                                    <span class="text-muted d-block small">/ @mec.Igrac2Partner?.Ime @mec.Igrac2Partner?.Prezime</span>
                                                                                }
                                                                            </span>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        if (rNo > 1)
                                                                        {
                                                                            var mNo = int.Parse(mec.MatchCode.Split('_').Last().Substring(1));
                                                                            var srcMatchNo = 2 * mNo;
                                                                            <span class="text-white-50 small text-uppercase italic">Pobjednik R@(rNo - 1) M@(srcMatchNo)</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted small italic">Slobodan prolaz (BYE)</span>
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>

                                                            <!-- Action -->
                                                            @if (isOrganizator && mec.Igrac1ID != null && mec.Igrac2ID != null && mec.Igrac1ID != "SLOBODAN" && mec.Igrac2ID != "SLOBODAN")
                                                            {
                                                                <div class="ps-3 border-start border-secondary ms-3">
                                                                    <button type="button" class="btn btn-outline-warning btn-sm fw-bold"
                                                                            data-bs-toggle="modal" data-bs-target="#unosRezultataModal"
                                                                            data-mec-id="@mec.ID"
                                                                            data-igrac1="@(mec.Igrac1?.Ime + " " + mec.Igrac1?.Prezime)"
                                                                            data-igrac1-partner="@(mec.Igrac1Partner != null ? mec.Igrac1Partner.Ime + " " + mec.Igrac1Partner.Prezime : "")"
                                                                            data-igrac2="@(mec.Igrac2?.Ime + " " + mec.Igrac2?.Prezime)"
                                                                            data-igrac2-partner="@(mec.Igrac2Partner != null ? mec.Igrac2Partner.Ime + " " + mec.Igrac2Partner.Prezime : "")"
                                                                            data-poeni1="@(mec.PoeniIgrac1 ?? 0)"
                                                                            data-poeni2="@(mec.PoeniIgrac2 ?? 0)"
                                                                            data-runda="@mec.Runda"
                                                                            data-grupa="@mec.NazivGrupe">
                                                                        <i class="bi bi-trophy-fill"></i> Unos
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </div>
                        }
                    </div>
                }
            </div>
            </div>
        </div>
    </div>

    <!-- Desni dio: Prijava na turnir i registrovani igrači -->
    <div class="col-12 col-lg-4">
        <!-- Prijava na turnir -->
        <div class="card bg-dark-card border border-dark-glow rounded-4 p-4 mb-4 shadow-lg text-center">
            <h4 class="text-white fw-bold mb-3">Registracija učešća</h4>
            <div class="mb-4">
                <span class="fs-1 text-orange">🏆</span>
                <div class="mt-2 text-white-50">Popunjeno: <strong class="text-white">@Model.Registracije.Count / @Model.MaxIgraca</strong> igrača</div>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (isRegistered)
                {
                    <div class="alert alert-success border border-success bg-success-transparent py-2 mb-3">
                        <i class="bi bi-check-circle-fill me-2"></i>Prijavljeni ste na ovaj turnir!
                    </div>
                    @if (Model.Status != StatusTurnira.Planiran || Model.Mecevi.Any())
                    {
                        <button class="btn btn-secondary w-100 py-2 fw-bold cursor-not-allowed" disabled>Odjave su zatvorene</button>
                    }
                    else
                    {
                        <form asp-action="Odjava" asp-route-id="@Model.ID" method="post" id="formOdjavaSingle">
                            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold"><i class="bi bi-x-circle me-2"></i>Odjavi se sa turnira</button>
                        </form>
                    }
                }
                else
                {
                    @if (Model.Registracije.Count >= Model.MaxIgraca)
                    {
                        <button class="btn btn-secondary w-100 py-2 fw-bold cursor-not-allowed" disabled>Turnir je popunjen</button>
                    }
                    else if (Model.Status != StatusTurnira.Planiran || Model.Mecevi.Any())
                    {
                        <button class="btn btn-secondary w-100 py-2 fw-bold cursor-not-allowed" disabled>Prijave su zatvorene</button>
                    }
                    else
                    {
                        <form asp-action="Registracija" asp-route-id="@Model.ID" method="post" id="formRegistracijaSingle">
                            <button type="submit" class="btn btn-orange w-100 py-2 text-white fw-bold shadow-glow"><i class="bi bi-clipboard-check me-2"></i>Prijavi se na turnir</button>
                        </form>
                    }
                }
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light-glow text-white w-100 py-2 fw-bold">Prijavite se za učešće</a>
            }
        </div>

        @if (isOrganizator && Model.Status == StatusTurnira.Planiran && !Model.Mecevi.Any())
        {
            var slobodniKorisniciList = ViewBag.SlobodniKorisnici as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
            
            <!-- Panel za dodavanje igrača (Organizator / Admin) -->
            <div class="card bg-dark-card border border-warning rounded-4 overflow-hidden shadow-lg mb-4">
                <div class="card-header bg-dark-card-footer border-bottom border-warning p-4">
                    <h5 class="text-warning fw-bold mb-0"><i class="bi bi-person-plus-fill me-2"></i>Dodaj igrača</h5>
                </div>
                <div class="card-body p-4">
                    @if (slobodniKorisniciList != null && slobodniKorisniciList.Any())
                    {
                        <!-- Kontrole za grupnu prijavu -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="form-check mb-0 d-flex align-items-center">
                                <input type="checkbox" class="form-check-input me-1" id="selectAllFreePlayers" style="cursor: pointer;" />
                                <label class="form-check-label text-white-50 small" for="selectAllFreePlayers" style="cursor: pointer; user-select: none;">Označi sve</label>
                            </div>
                            <button type="submit" form="bulkRegisterForm" id="btnBulkRegister"
                                    class="btn btn-warning btn-sm px-3 fw-bold d-none">
                                <i class="bi bi-person-check-fill me-1"></i> Prijavi označene (<span id="selectedFreePlayersCount">0</span>)
                            </button>
                            <span id="bulkRegisterFullMsg" class="d-none text-danger small fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Turnir je popunjen!</span>
                        </div>

                        <form asp-action="DodajViseIgraca" method="post" id="bulkRegisterForm" class="mb-4 pb-4 border-bottom border-dark-glow">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="turnirId" value="@Model.ID" />

                            <!-- Filter pretraga -->
                            <div class="mb-2">
                                <input type="text" id="filterFreePlayersInput" class="form-control form-control-sm bg-dark-input border-dark-glow text-white placeholder-muted"
                                       placeholder="🔍 Pretraži igrače..." autocomplete="off" />
                            </div>

                            <!-- Lista slobodnih igrača sa checkboxima -->
                            <div id="freePlayers-list" style="max-height: 280px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 4px 0;">
                                @foreach (var item in slobodniKorisniciList)
                                {
                                    <div class="free-player-row d-flex align-items-center px-3 py-2" style="border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s;">
                                        <input type="checkbox" name="korisnikIds" value="@item.Value"
                                               class="form-check-input free-player-checkbox me-3"
                                               id="freePlayer_@item.Value"
                                               style="cursor: pointer; width: 1.15em; height: 1.15em;" />
                                        <label for="freePlayer_@item.Value" class="text-white small mb-0 flex-grow-1"
                                               style="cursor: pointer; user-select: none;"
                                               data-search="@item.Text.ToLower()">
                                            <i class="bi bi-person text-orange me-1" style="font-size:0.85rem;"></i>
                                            @item.Text
                                        </label>
                                    </div>
                                }
                                <div id="noMatchingFreePlayersMsg" class="d-none text-center text-muted p-3 small">
                                    <i class="bi bi-search me-1"></i> Nema igrača koji odgovaraju pretrazi.
                                </div>
                            </div>
                        </form>
                    }

                    <!-- Kreiraj novog gosta -->
                    <form asp-action="DodajNovogGosta" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="turnirId" value="@Model.ID" />
                        <label class="form-label text-white fw-semibold small d-block mb-3">Kreiraj novog gosta:</label>
                        <div class="mb-3">
                            <input type="text" name="ime" placeholder="Ime igrača..." class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" required />
                        </div>
                        <div class="mb-3">
                            <input type="text" name="prezime" placeholder="Prezime igrača..." class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" required />
                        </div>
                        <div class="mb-3">
                            <input type="text" name="grad" placeholder="Grad..." class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" />
                        </div>
                        <button type="submit" class="btn btn-outline-warning w-100 fw-bold"><i class="bi bi-person-plus"></i> Kreiraj i dodaj gosta</button>
                    </form>
                </div>
            </div>
        }

        <!-- Spisak registrovanih igrača -->
        <div class="card bg-dark-card border border-dark-glow rounded-4 overflow-hidden shadow-lg">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-4">
                <h5 class="text-white fw-bold mb-0"><i class="bi bi-people-fill text-orange me-2"></i>Prijavljeni igrači (@Model.Registracije.Count)</h5>
            </div>
            <div class="card-body p-4">
                @if (!Model.Registracije.Any())
                {
                    <div class="text-center py-4 text-white-50 small">
                        <i class="bi bi-emoji-frown fs-3 mb-2 d-block"></i>Još uvijek nema prijavljenih igrača.
                    </div>
                }
                else
                {
                    @if (isOrganizator && Model.Status == StatusTurnira.Planiran && !Model.Mecevi.Any() && Model.Registracije.Any())
                    {
                        <!-- Kontrole za grupnu odjavu - ispod naslova -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="form-check mb-0 d-flex align-items-center">
                                <input type="checkbox" class="form-check-input me-1" id="selectAllPlayers" style="cursor: pointer;" />
                                <label class="form-check-label text-white-50 small" for="selectAllPlayers" style="cursor: pointer; user-select: none;">Označi sve</label>
                            </div>
                            <button type="submit" form="bulkUnregisterForm" id="btnBulkUnregister" class="btn btn-danger btn-sm px-3 fw-bold d-none" onclick="return confirm('Da li ste sigurni da želite odjaviti označene igrače sa turnira?');">
                                <i class="bi bi-trash-fill me-1"></i> Odjavi označene (<span id="selectedPlayersCount">0</span>)
                            </button>
                        </div>
                    }
                    <form asp-controller="Turnir" asp-action="UkloniViseIgraca" method="post" id="bulkUnregisterForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="turnirId" value="@Model.ID" />
                        <ul class="list-group list-group-flush bg-transparent">
                            @foreach (var reg in Model.Registracije)
                            {
                                <li class="list-group-item bg-transparent border-bottom border-dark-glow px-0 py-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        @if (isOrganizator && Model.Status == StatusTurnira.Planiran && !Model.Mecevi.Any())
                                        {
                                            <input type="checkbox" name="korisnikIds" value="@reg.KorisnikID" class="form-check-input player-select-checkbox me-3" style="cursor: pointer; width: 1.15em; height: 1.15em;" />
                                        }
                                        <div class="user-avatar-mini me-3">
                                            @if (reg.Korisnik != null && reg.Korisnik.Ime.Length > 0)
                                            {
                                                <span>@reg.Korisnik.Ime[0]</span>
                                            }
                                            else
                                            {
                                                <span>I</span>
                                            }
                                        </div>
                                        <div>
                                            <a href="/Korisnik/Index/@reg.KorisnikID" class="text-white hover-orange fw-bold">
                                                @reg.Korisnik?.Ime @reg.Korisnik?.Prezime
                                                @if (reg.Korisnik != null && reg.Korisnik.IsGost)
                                                {
                                                    <span class="badge bg-secondary text-muted ms-1" style="font-size: 0.75rem; vertical-align: middle;">Gost</span>
                                                }
                                            </a>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <small class="text-muted">@reg.Korisnik?.Grad</small>
                                                <span class="badge bg-dark-glow border border-dark-glow text-orange rounded-pill pot-badge-sidebar" id="sidebar-pot-badge-@reg.KorisnikID" style="font-size: 0.7rem; padding: 2px 6px;">Šešir @reg.Sesir</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-dark-glow border border-dark-glow text-orange rounded-pill small px-2 py-1">Registriran</span>
                                        @if (isOrganizator && Model.Status == StatusTurnira.Planiran && !Model.Mecevi.Any())
                                        {
                                            <button type="submit" form="singleDeleteForm_@reg.KorisnikID" class="btn btn-outline-danger btn-sm p-1" style="line-height:1;" title="Ukloni igrača">
                                                <i class="bi bi-trash-fill" style="font-size: 0.85rem;"></i>
                                            </button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </form>

                    @if (isOrganizator && Model.Status == StatusTurnira.Planiran && !Model.Mecevi.Any())
                    {
                        foreach (var reg in Model.Registracije)
                        {
                            <form id="singleDeleteForm_@reg.KorisnikID" asp-controller="Turnir" asp-action="UkloniIgraca" method="post" style="display:none;" onsubmit="return confirm('Da li ste sigurni da želite ukloniti ovog igrača sa turnira?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="turnirId" value="@Model.ID" />
                                <input type="hidden" name="korisnikId" value="@reg.KorisnikID" />
                            </form>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Logika za masovno odjavljivanje igrača
            const selectAllCb = document.getElementById("selectAllPlayers");
            const playerCbs = document.querySelectorAll(".player-select-checkbox");
            const btnBulk = document.getElementById("btnBulkUnregister");
            const countSpan = document.getElementById("selectedPlayersCount");

            function updateBulkUnregisterState() {
                if (!playerCbs || playerCbs.length === 0) return;
                const checkedCount = document.querySelectorAll(".player-select-checkbox:checked").length;
                if (countSpan) countSpan.textContent = checkedCount;

                if (checkedCount > 0) {
                    if (btnBulk) btnBulk.classList.remove("d-none");
                } else {
                    if (btnBulk) btnBulk.classList.add("d-none");
                }

                if (selectAllCb) {
                    selectAllCb.checked = checkedCount === playerCbs.length && playerCbs.length > 0;
                    selectAllCb.indeterminate = checkedCount > 0 && checkedCount < playerCbs.length;
                }
            }

            if (selectAllCb) {
                selectAllCb.addEventListener("change", function () {
                    const isChecked = this.checked;
                    playerCbs.forEach(cb => {
                        cb.checked = isChecked;
                    });
                    updateBulkUnregisterState();
                });
            }

            playerCbs.forEach(cb => {
                cb.addEventListener("change", updateBulkUnregisterState);
            });

            // Logika za masovnu prijavu igrača
            const selectAllFreeCb = document.getElementById("selectAllFreePlayers");
            const freeCbs = document.querySelectorAll(".free-player-checkbox");
            const btnBulkReg = document.getElementById("btnBulkRegister");
            const countSpanReg = document.getElementById("selectedFreePlayersCount");

            function getVisibleFreeCbs() {
                return Array.from(document.querySelectorAll(".free-player-checkbox")).filter(cb => {
                    const row = cb.closest(".free-player-row");
                    return row && !row.classList.contains("d-none") && row.style.display !== "none";
                });
            }

            const maxIgraca = @Model.MaxIgraca;
            const brRegistrovanih = @Model.Registracije.Count;
            const slobodnaMjesta = maxIgraca - brRegistrovanih;
            const turnirPopunjen = slobodnaMjesta <= 0;
            const bulkFullMsg = document.getElementById("bulkRegisterFullMsg");

            // Toast funkcija - prikazuje poruku kao alert na vrhu stranice
            function showJsToast(message, type) {
                const alertClass = type === "warning" ? "alert-warning" : "alert-danger";
                const iconClass  = type === "warning" ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill";
                const toast = document.createElement("div");
                toast.className = `alert ${alertClass} alert-dismissible fade show custom-alert shadow-lg`;
                toast.setAttribute("role", "alert");
                toast.innerHTML = `<i class="bi ${iconClass} me-2"></i>${message}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>`;
                // Ubaci na isto mjesto gdje TempData poruke idu (vrh main sadržaja)
                const main = document.querySelector("main");
                if (main) main.insertBefore(toast, main.firstChild);
                // Auto-sakrij nakon 6 sekundi
                setTimeout(() => {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(toast);
                    if (bsAlert) bsAlert.close();
                }, 6000);
            }

            function updateBulkRegisterState() {
                const checkedCount = Array.from(document.querySelectorAll(".free-player-checkbox:checked")).length;
                if (countSpanReg) countSpanReg.textContent = checkedCount;

                // Sakrij "popunjen" poruku i dugme po defaultu
                if (bulkFullMsg) bulkFullMsg.classList.add("d-none");
                if (btnBulkReg) btnBulkReg.classList.add("d-none");

                if (checkedCount > 0) {
                    if (turnirPopunjen) {
                        if (bulkFullMsg) bulkFullMsg.classList.remove("d-none");
                    } else {
                        if (btnBulkReg) btnBulkReg.classList.remove("d-none");
                    }
                }

                if (selectAllFreeCb) {
                    const visibleCbs = getVisibleFreeCbs();
                    const visibleChecked = visibleCbs.filter(cb => cb.checked).length;
                    selectAllFreeCb.checked = visibleChecked === visibleCbs.length && visibleCbs.length > 0;
                    selectAllFreeCb.indeterminate = visibleChecked > 0 && visibleChecked < visibleCbs.length;
                }
            }

            // Intercept submit – traži potvrdu u skočnom prozoru ako je označeno više igrača nego što ima slobodnih mjesta
            const bulkRegForm = document.getElementById("bulkRegisterForm");
            if (bulkRegForm) {
                bulkRegForm.addEventListener("submit", function (e) {
                    const checkedCount = Array.from(document.querySelectorAll(".free-player-checkbox:checked")).length;
                    if (checkedCount > slobodnaMjesta) {
                        const poruka = `Pokušavate prijaviti ${checkedCount} igrača, ali na turniru ima samo ${slobodnaMjesta} slobodnih mjesta (maksimalan kapacitet: ${maxIgraca}). Prijavit će se samo prvih ${slobodnaMjesta} označenih igrača.`;
                        if (!confirm(poruka)) {
                            e.preventDefault();
                            return false;
                        }
                    }
                });
            }

            if (selectAllFreeCb) {
                selectAllFreeCb.addEventListener("change", function () {
                    const isChecked = this.checked;
                    getVisibleFreeCbs().forEach(cb => { cb.checked = isChecked; });
                    updateBulkRegisterState();
                });
            }

            freeCbs.forEach(cb => {
                cb.addEventListener("change", updateBulkRegisterState);
            });

            // Filter / pretraga slobodnih igrača
            const filterInput = document.getElementById("filterFreePlayersInput");
            if (filterInput) {
                filterInput.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        return false;
                    }
                });

                filterInput.addEventListener("input", function () {
                    const query = this.value.toLowerCase().trim();
                    let matchCount = 0;
                    document.querySelectorAll(".free-player-row").forEach(row => {
                        const label = row.querySelector("label[data-search]");
                        const searchVal = label ? (label.getAttribute("data-search") || label.textContent).toLowerCase() : row.textContent.toLowerCase();
                        const isMatch = !query || searchVal.includes(query);
                        
                        if (isMatch) {
                            row.classList.remove("d-none");
                            matchCount++;
                        } else {
                            row.classList.add("d-none");
                            const cb = row.querySelector(".free-player-checkbox");
                            if (cb) cb.checked = false;
                        }
                    });

                    const noMatchMsg = document.getElementById("noMatchingFreePlayersMsg");
                    if (noMatchMsg) {
                        if (matchCount === 0) {
                            noMatchMsg.classList.remove("d-none");
                        } else {
                            noMatchMsg.classList.add("d-none");
                        }
                    }

                    updateBulkRegisterState();
                });
            }

            // Tab recovery code
            var tabTriggers = document.querySelectorAll('#tournamentTabs button[data-bs-toggle="pill"]');
            var storageKey = 'activeTab_Turnir_' + '@Model.ID';
            var savedTabId = localStorage.getItem(storageKey);
            if (savedTabId) {
                var tabEl = document.getElementById(savedTabId);
                if (tabEl) {
                    var tab = new bootstrap.Tab(tabEl);
                    tab.show();
                }
            }
            tabTriggers.forEach(function (tabEl) {
                tabEl.addEventListener('shown.bs.tab', function (event) {
                    localStorage.setItem(storageKey, event.target.id);
                });
            });
            // Scroll tabova ulijevo / udesno
            const scrollContainer = document.getElementById("tournamentTabsScrollContainer");
            const btnLeft = document.getElementById("scrollTabsLeft");
            const btnRight = document.getElementById("scrollTabsRight");

            if (scrollContainer && btnLeft && btnRight) {
                btnLeft.addEventListener("click", function () {
                    scrollContainer.scrollTo({ left: 0, behavior: "smooth" });
                });

                btnRight.addEventListener("click", function () {
                    scrollContainer.scrollTo({ left: scrollContainer.scrollWidth, behavior: "smooth" });
                });
            }

            // --- SEEDING LOGIKA ---
            const seedingContainer = document.querySelector('.seeding-container');
            if (seedingContainer) {
                const isOrg = @(isOrganizator ? "true" : "false");

                // 1. Izračunaj kapacitete šešira
                function calculatePotCapacities(N) {
                    if (N === 5) {
                        return { pot1: 1, pot2: 1, pot3: 1, pot4: 2, G: 1, x: 1 };
                    }
                    let x = 0;
                    let y = 0;
                    for (let candX = Math.floor(N / 4); candX >= 0; candX--) {
                        let ostalo = N - (candX * 4);
                        if (ostalo % 3 === 0) {
                            x = candX;
                            y = ostalo / 3;
                            break;
                        }
                    }
                    let G = x + y;
                    let pot4Cap = Math.max(0, N - (3 * G));
                    return { pot1: G, pot2: G, pot3: G, pot4: pot4Cap, G: G, x: x };
                }

                // 2. Validacija šešira
                function validatePots() {
                    const cards = document.querySelectorAll('.player-draggable-card');
                    const N = cards.length;
                    const caps = calculatePotCapacities(N);

                    let potCount = [0, 0, 0, 0, 0];
                    for (let s = 1; s <= 4; s++) {
                        potCount[s] = document.querySelectorAll('#pot-zone-' + s + ' .player-draggable-card').length;
                        document.getElementById('pot-counter-' + s).innerText = potCount[s] + ' / ' + (s === 4 ? caps.pot4 : caps.pot1);
                    }

                    let errors = [];
                    if (potCount[1] !== caps.pot1) errors.push('Šešir 1 ima ' + potCount[1] + '/' + caps.pot1);
                    if (potCount[2] !== caps.pot2) errors.push('Šešir 2 ima ' + potCount[2] + '/' + caps.pot2);
                    if (potCount[3] !== caps.pot3) errors.push('Šešir 3 ima ' + potCount[3] + '/' + caps.pot3);
                    if (potCount[4] !== caps.pot4) errors.push('Šešir 4 ima ' + potCount[4] + '/' + caps.pot4);

                    const validationAlert = document.getElementById('validationAlert');
                    const validationText = document.getElementById('validationText');
                    const validationStatusBadge = document.getElementById('validationStatusBadge');
                    const submitBtn = document.getElementById('btnGenerisiGrupeSubmit');

                    if (errors.length === 0) {
                        validationAlert.className = "alert alert-success border border-success bg-success-transparent d-flex align-items-center justify-content-between py-2 px-3 mb-4 rounded-3 small";
                        let groupText = N === 5 ? "1 grupa sa 5 igrača" : ("Grupe: " + caps.G + ", od čega " + caps.x + " sa 4 igrača");
                        validationText.innerHTML = "<i class='bi bi-check-circle-fill text-success me-2'></i><strong>Šeširi su balansirani!</strong> Raspodjela je ispravna za " + N + " igrača (" + groupText + ").";
                        validationStatusBadge.className = "badge bg-success text-dark";
                        validationStatusBadge.innerText = "Ispravno";
                        if (submitBtn) submitBtn.disabled = false;
                        return true;
                    } else {
                        validationAlert.className = "alert alert-danger border border-danger bg-danger-transparent d-flex align-items-center justify-content-between py-2 px-3 mb-4 rounded-3 small";
                        const actionInstruction = isOrg ? "Prevucite igrače da izbalansirate šešire." : "Čeka se da organizator izbalansira šešire.";
                        validationText.innerHTML = "<i class='bi bi-exclamation-triangle-fill text-danger me-2'></i><strong>Nevalidna raspodjela šešira!</strong> " + actionInstruction;
                        validationStatusBadge.className = "badge bg-danger";
                        validationStatusBadge.innerText = "Neispravno";
                        if (submitBtn) submitBtn.disabled = true;
                        return false;
                    }
                }

                // Inicijalna validacija
                validatePots();

                if (isOrg) {
                    // Autosave funkcija
                    async function autosavePots() {
                        let mapping = [];
                        for (let s = 1; s <= 4; s++) {
                            const cardsInPot = document.querySelectorAll('#pot-zone-' + s + ' .player-draggable-card');
                            cardsInPot.forEach(card => {
                                mapping.push({
                                    KorisnikId: card.dataset.playerId,
                                    Sesir: s
                                });
                            });
                        }
                        try {
                            const response = await fetch('/Turnir/SacuvajSesire', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded'
                                },
                                body: 'turnirId=' + @Model.ID + '&playerPotsJson=' + encodeURIComponent(JSON.stringify(mapping))
                            });
                        } catch (err) {
                            console.error("Autosave error:", err);
                        }
                    }

                    // 3. Drag and Drop handlers
                    const draggableCards = document.querySelectorAll('.player-draggable-card');
                    const dropZones = document.querySelectorAll('.pot-drop-zone');

                    draggableCards.forEach(card => {
                        card.addEventListener('dragstart', () => {
                            card.classList.add('dragging');
                        });

                        card.addEventListener('dragend', () => {
                            card.classList.remove('dragging');
                        });
                    });

                    dropZones.forEach(zone => {
                        zone.addEventListener('dragover', e => {
                            e.preventDefault();
                            zone.classList.add('dragover');
                        });

                        zone.addEventListener('dragleave', () => {
                            zone.classList.remove('dragover');
                        });

                        zone.addEventListener('drop', async e => {
                            e.preventDefault();
                            zone.classList.remove('dragover');
                            const card = document.querySelector('.player-draggable-card.dragging');
                            if (card) {
                                zone.appendChild(card);
                                
                                // Ažuriraj sporedni bedž na sidebar listi
                                const pId = card.dataset.playerId;
                                const targetPot = zone.dataset.pot;
                                const sidebarBadge = document.getElementById('sidebar-pot-badge-' + pId);
                                if (sidebarBadge) {
                                    sidebarBadge.innerText = 'Šešir ' + targetPot;
                                }
                                validatePots();
                                await autosavePots();
                            }
                        });
                    });

                    // 4. Seeding Source dropdown promjena
                    const sourceTypeSelect = document.getElementById('seedingSourceType');
                    const sourceLigaContainer = document.getElementById('seedingSourceLigaContainer');
                    const sourceTurnirContainer = document.getElementById('seedingSourceTurnirContainer');

                    sourceTypeSelect.addEventListener('change', function () {
                        const val = this.value;
                        sourceLigaContainer.classList.add('d-none');
                        sourceTurnirContainer.classList.add('d-none');

                        if (val === 'DrugaLiga') {
                            sourceLigaContainer.classList.remove('d-none');
                        } else if (val === 'DrugiTurnir') {
                            sourceTurnirContainer.classList.remove('d-none');
                        }
                    });

                    // 5. Klik na "Auto-raspodjela"
                    const btnAutoSeeding = document.getElementById('btnAutoSeeding');
                    btnAutoSeeding.addEventListener('click', async function () {
                        const type = sourceTypeSelect.value;
                        const cards = Array.from(document.querySelectorAll('.player-draggable-card'));
                        const N = cards.length;
                        const caps = calculatePotCapacities(N);

                        if (type === 'Random') {
                            // Potpuno random raspodjela
                            // Promiješaj niz
                            for (let i = cards.length - 1; i > 0; i--) {
                                const j = Math.floor(Math.random() * (i + 1));
                                [cards[i], cards[j]] = [cards[j], cards[i]];
                            }
                            // Postavi bodove na 0 i ažuriraj UI
                            cards.forEach(card => {
                                card.dataset.points = 0;
                                card.querySelector('.player-points-text').innerText = '0';
                            });
                            
                            await distributeSortedCards(cards, caps);
                            return;
                        }

                        if (type === 'TrenutnaLiga') {
                            // Vrati bodove na podrazumijevane iz ViewBag-a
                            // Koji su već renderisani kao data-points u HTML!
                            // Jednostavno ponovo sortiraj i podijeli
                            // Ali za svaki slučaj, ako je ovo prvo kolo pa su svi 0, staviće ih u najslabiji šešir
                            await distributeSortedCardsByRules(cards, caps);
                            return;
                        }

                        // Druga liga ili Drugi turnir -> AJAX dohvati
                        let sourceId = 0;
                        if (type === 'DrugaLiga') {
                            sourceId = document.getElementById('seedingSourceLiga').value;
                            if (!sourceId) { alert("Molimo odaberite ligu!"); return; }
                        } else if (type === 'DrugiTurnir') {
                            sourceId = document.getElementById('seedingSourceTurnir').value;
                            if (!sourceId) { alert("Molimo odaberite turnir!"); return; }
                        }

                        btnAutoSeeding.disabled = true;
                        btnAutoSeeding.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Učitavanje...';

                        try {
                            const response = await fetch(`/Turnir/DohvatiRankinge?sourceType=${type === 'DrugaLiga' ? 'Liga' : 'Turnir'}&sourceId=${sourceId}`);
                            if (!response.ok) throw new Error("Došlo je do greške pri učitavanju.");
                            const rankings = await response.json(); // Map: KorisnikId -> Bodovi

                            // Ažuriraj bodove na karticama
                            cards.forEach(card => {
                                const pId = card.dataset.playerId;
                                const points = rankings[pId] !== undefined ? rankings[pId] : 0;
                                card.dataset.points = points;
                                card.querySelector('.player-points-text').innerText = points;
                            });

                            await distributeSortedCardsByRules(cards, caps);
                        } catch (err) {
                            alert("Greška: " + err.message);
                        } finally {
                            btnAutoSeeding.disabled = false;
                            btnAutoSeeding.innerHTML = '<i class="bi bi-magic me-1"></i> Auto-raspodjela';
                        }
                    });

                    // Pomoćna metoda za raspodjelu uz poštovanje pravila "novi igrači idu u najslabiji šešir"
                    async function distributeSortedCardsByRules(cards, caps) {
                        // Sortiraj tako da oni sa bodovima > 0 idu na vrh (desc), a sa bodovima == 0 (novi/nerankirani) na dno (asc po datumu)
                        cards.sort((a, b) => {
                            let ptsA = parseInt(a.dataset.points) || 0;
                            let ptsB = parseInt(b.dataset.points) || 0;

                            // Ako je jedan novi (0), a drugi rankiran (>0)
                            if (ptsA > 0 && ptsB === 0) return -1;
                            if (ptsA === 0 && ptsB > 0) return 1;

                            // Ako su obojica rankirani, sort po bodovima desc
                            if (ptsA !== ptsB) return ptsB - ptsA;

                            // Ako su jednaki, po datumu registracije asc (fer-plej)
                            let dateA = new Date(a.dataset.regDate);
                            let dateB = new Date(b.dataset.regDate);
                            return dateA - dateB;
                        });

                        await distributeSortedCards(cards, caps);
                    }

                    // Fizički raspodijeli kartice u DOM-u u odgovarajuće šešire
                    async function distributeSortedCards(sortedCards, caps) {
                        let idx = 0;
                        const N = sortedCards.length;

                        // Šešir 1
                        const z1 = document.getElementById('pot-zone-1');
                        z1.innerHTML = '';
                        for (let i = 0; i < caps.pot1 && idx < N; i++) {
                            z1.appendChild(sortedCards[idx]);
                            updateSidebarBadge(sortedCards[idx].dataset.playerId, 1);
                            idx++;
                        }

                        // Šešir 2
                        const z2 = document.getElementById('pot-zone-2');
                        z2.innerHTML = '';
                        for (let i = 0; i < caps.pot2 && idx < N; i++) {
                            z2.appendChild(sortedCards[idx]);
                            updateSidebarBadge(sortedCards[idx].dataset.playerId, 2);
                            idx++;
                        }

                        // Šešir 3
                        const z3 = document.getElementById('pot-zone-3');
                        z3.innerHTML = '';
                        for (let i = 0; i < caps.pot3 && idx < N; i++) {
                            z3.appendChild(sortedCards[idx]);
                            updateSidebarBadge(sortedCards[idx].dataset.playerId, 3);
                            idx++;
                        }

                        // Šešir 4
                        const z4 = document.getElementById('pot-zone-4');
                        z4.innerHTML = '';
                        for (let i = 0; i < caps.pot4 && idx < N; i++) {
                            z4.appendChild(sortedCards[idx]);
                            updateSidebarBadge(sortedCards[idx].dataset.playerId, 4);
                            idx++;
                        }

                        validatePots();
                        await autosavePots();
                    }

                    function updateSidebarBadge(pId, pot) {
                        const badge = document.getElementById('sidebar-pot-badge-' + pId);
                        if (badge) {
                            badge.innerText = 'Šešir ' + pot;
                        }
                    }

                    // 6. Submit forme za generisanje grupa - snimi šešire u JSON
                    const formGenerisiGrupe = document.getElementById('formGenerisiGrupe');
                    if (formGenerisiGrupe) {
                        formGenerisiGrupe.addEventListener('submit', function (e) {
                            if (!validatePots()) {
                                e.preventDefault();
                                alert("Nevalidni šeširi! Molimo uravnotežite šešire prije generisanja grupa.");
                                return;
                            }

                            // Sakupi trenutnu raspodjelu u JSON
                            let mapping = [];
                            for (let s = 1; s <= 4; s++) {
                                const cardsInPot = document.querySelectorAll('#pot-zone-' + s + ' .player-draggable-card');
                                cardsInPot.forEach(card => {
                                    mapping.push({
                                        KorisnikId: card.dataset.playerId,
                                        Sesir: s
                                    });
                                });
                            }
                            document.getElementById('playerPotsJson').value = JSON.stringify(mapping);
                        });
                    }
                }
            }
        });
    </script>
}

<!-- Modal za Unos Rezultata Meča -->
<div class="modal fade" id="unosRezultataModal" tabindex="-1" aria-labelledby="unosRezultataModalLabel" aria-hidden="true">
