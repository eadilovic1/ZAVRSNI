@model ePinPong.Models.ViewModels.TurnirDetailsViewModel
@using ePinPong.Models.ViewModels
@{
    ViewData["Title"] = Model.Naziv;
    var isRegistered = Model.IsRegistered;
    var isOrganizator = Model.IsOrganizator;
    var isAdmin = Model.IsAdmin;
    var currentUserId = Model.CurrentUserId;

    var grupniMecevi = Model.GrupniMecevi;
    var zavrsniMecevi = Model.ZavrsniMecevi;
    var razigravanjeMecevi = Model.RazigravanjeMecevi;
    var sviZavrsniMecevi = Model.SviZavrsniMecevi;
    var ranking = Model.Ranking;
    var playerPoints = Model.PlayerPoints;
    var isMasters = Model.IsMasters;
    var utjesniMecevi = Model.UtjesniMecevi;
    var utjesniGlavniMecevi = Model.UtjesniGlavniMecevi;
    var utjesniRazigravanjeMecevi = Model.UtjesniRazigravanjeMecevi;
    var brojGrupaUTurniru = Model.BrojGrupaUTurniru;
    var isGroupOnly = Model.IsGroupOnly;
}

<style>
    .nav-pills .nav-link {
        background-color: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
    }
    .nav-pills .nav-link:hover {
        background-color: rgba(255, 120, 0, 0.1);
        color: #ff7800 !important;
    }
    .nav-pills .nav-link.active,
    .nav-pills .nav-link.active.text-white {
        background-color: #ff7800 !important;
        color: #000000 !important;
        box-shadow: 0 0 15px rgba(255, 120, 0, 0.4);
    }
    .nav-pills .nav-link.active i,
    .nav-pills .nav-link.active .text-orange {
        color: #000000 !important;
    }
    .bg-success-transparent-row {
        background-color: rgba(40, 167, 69, 0.1) !important;
    }
    .bg-warning-transparent-row {
        background-color: rgba(255, 193, 7, 0.15) !important;
    }
    .toggle-chevron {
        transition: transform 0.2s ease-in-out;
        display: inline-block;
    }
    .btn-collapse-toggle[aria-expanded="false"] .toggle-chevron {
        transform: rotate(180deg);
    }
    .user-avatar-mini-x {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.75rem;
        color: #ff7800;
        border: 1px solid rgba(255, 120, 0, 0.2);
    }
    .player-draggable-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }
    .player-draggable-card:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
        border-color: rgba(255, 120, 0, 0.2) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }
    .player-draggable-card.dragging {
        opacity: 0.4;
        border: 1px dashed #ff7800 !important;
        transform: scale(0.98);
    }
    .pot-drop-zone {
        border: 1px dashed transparent;
        border-radius: 6px;
    }
    .pot-drop-zone.dragover {
        background-color: rgba(255, 120, 0, 0.05) !important;
        border-color: rgba(255, 120, 0, 0.3) !important;
    }
    .bg-info-transparent {
        background-color: rgba(23, 162, 184, 0.08) !important;
    }
    .bg-danger-transparent {
        background-color: rgba(220, 53, 69, 0.08) !important;
    }
</style>

<div class="row g-4 py-4">
    <!-- Lijevi dio: Detalji turnira i akcije -->
    <div class="col-12 col-lg-8">
        <!-- Turnir kartica / zaglavlje -->
        <partial name="_HeaderCard" model="Model" />

        @if (!isMasters && (Model.Status == StatusTurnira.Zavrsen || (isGroupOnly && grupniMecevi.Any() && grupniMecevi.All(m => m.Odigran))) && ranking != null && ranking.Any())
        {
            <partial name="_FinalRankingTable" model="Model" />
        }

        @if (isMasters && (Model.Status == StatusTurnira.Zavrsen || (grupniMecevi.Any() && grupniMecevi.All(m => m.Odigran))))
        {
            <partial name="_MastersPodiums" model="Model" />
        }

        <!-- Raspored mečeva i tabele -->
        <div class="card bg-dark-card border border-dark-glow rounded-4 overflow-hidden shadow-lg mb-4">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-4 d-flex justify-content-between align-items-center">
                <h4 class="text-white fw-bold mb-0"><i class="bi bi-grid-3x3-gap-fill text-orange me-2"></i>Raspored mečeva i tabele</h4>
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-light-glow btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" type="button" data-bs-toggle="collapse" data-bs-target="#overallScheduleCollapse" aria-expanded="true" aria-controls="overallScheduleCollapse">
                        <i class="bi bi-chevron-up toggle-chevron"></i>
                    </button>
                </div>
            </div>
            <div class="collapse show" id="overallScheduleCollapse">
                <div class="card-body p-4">
                @if (!Model.Mecevi.Any())
                {
                    @if (Model.Status == StatusTurnira.Planiran && Model.Registracije.Count >= 3)
                    {
                        @if (isMasters)
                        {
                            <partial name="_MastersSeedingPanel" model="Model" />
                        }
                        else
                        {
                            <partial name="_SeedingPotsPanel" model="Model" />
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-info-circle text-white-50 fs-2 mb-3"></i>
                            <h5 class="text-white">Mečevi još nisu generisani</h5>
                            <p class="text-white-50 small mb-0">Raspored mečeva i tabele će biti dostupni kada organizator pokrene generisanje grupa. Za početak turnira potrebna su najmanje 3 igrača.</p>
                        </div>
                    }
                }
                else
                {
                    @if (!isMasters)
                    {
                        <partial name="_TabNav" model="Model" />
                    }

                    <div class="tab-content" id="tournamentTabsContent">
                        <partial name="_GroupsTab" model="Model" />

                        @if (!isMasters)
                        {
                            <partial name="_KnockoutTab" model="Model" />
                        }

                        <!-- Pane: Razigravanje za mjesta -->
                        @if (!isMasters)
                        {
                            <partial name="_PlacementTab" model="Model" />
                        }

                        <!-- Pane: Utješni turnir (bracket, isti format kao Glavni turnir) -->
                        @if (!isMasters)
                        {
                            <partial name="_ConsolationTab" model="Model" />
                        }

                        <!-- Pane: Razigravanje (Utješni) – isti format kao glavni Razigravanje -->
                        @if (!isMasters)
                        {
                            <partial name="_ConsolationPlacementTab" model="Model" />
                        }

                        <!-- Pane: Turnir Parova -->
                        @if (Model.Status == StatusTurnira.UToku || Model.Status == StatusTurnira.Zavrsen)
                        {
                            <partial name="_DoublesTab" model="Model" />
                        }
                    </div>
                }
            </div>
            </div>
        </div>
    </div>

    <!-- Desni dio: Prijava na turnir i registrovani igrači -->
    <div class="col-12 col-lg-4">
        <partial name="_RegistrationPanel" model="Model" />

        @if (isOrganizator && Model.Status == StatusTurnira.Planiran && !Model.Mecevi.Any())
        {
            <partial name="_AddPlayerPanel" model="Model" />
        }

        <partial name="_RegisteredPlayersList" model="Model" />
    </div>
              
</div>


<!-- Modal za Unos Rezultata Meča -->
<partial name="_ResultModal" model="Model" />

@section Scripts {
    <partial name="_RegistrationScripts" model="Model" />
    <partial name="_SeedingScripts" model="Model" />
    <partial name="_ResultModalScripts" model="Model" />
}
