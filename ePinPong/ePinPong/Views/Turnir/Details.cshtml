                                    <i class="bi bi-dash-lg fs-5"></i>
                                </button>
                                <input type="text" id="modalPoeniIgrac1" name="poeniIgrac1" class="form-control form-control-lg bg-dark border border-dark-glow text-white text-center fw-bold fs-3 font-monospace px-0" style="width: 70px; height: 50px;" readonly value="0" />
                                <button type="button" class="btn btn-outline-success rounded-circle d-flex align-items-center justify-content-center" id="modalBtnIncP1" style="width: 40px; height: 40px; border-width: 2px;">
