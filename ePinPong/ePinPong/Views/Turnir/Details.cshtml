                                <span id="modalP1Init">P1</span>
                            </div>
                            <h6 id="modalP1Name" class="text-white fw-bold mb-1 fs-5">Igrač 1</h6>
                            
                            <!-- P1 set counter -->
                            <div class="d-flex align-items-center justify-content-center gap-2 mt-3">
