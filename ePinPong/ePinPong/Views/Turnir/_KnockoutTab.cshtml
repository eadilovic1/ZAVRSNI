@model ePinPong.Models.ViewModels.TurnirDetailsViewModel

@{
    var rundeZavrsnice = Model.ZavrsniMecevi.GroupBy(m => m.Runda).OrderBy(g => g.Key).ToList();
}

<!-- Pane: Glavni turnir -->
<div class="tab-pane fade" id="knockout-pane" role="tabpanel" aria-labelledby="knockout-tab" tabindex="0">
    @if (!Model.SviZavrsniMecevi.Any())
    {
        @if (Model.IsGroupOnly)
        {
            <div class="text-center py-5">
                <i class="bi bi-grid-3x3-gap-fill text-orange fs-2 mb-3"></i>
                <h5 class="text-white fw-bold">Grupna faza je konačni plasman</h5>
                <p class="text-white-50 small mb-0">Ovaj turnir nema posebnu završnicu. Konačni poredak određen je rezultatima grupne faze.</p>
            </div>
        }
        else
        {
        <div class="text-center py-5">
            <i class="bi bi-trophy text-white-50 fs-2 mb-3"></i>
            <h5 class="text-white">Glavni turnir još nije generisan</h5>
            @if (Model.IsOrganizator && Model.GrupniMecevi.All(m => m.Odigran))
            {
                <p class="text-white-50 small mb-3">Grupna faza je uspješno završena. Generišite parove glavnog turnira kako biste nastavili turnir.</p>
                <form asp-controller="Mec" asp-action="GenerirajZavrsnicu" method="post">
                    <input type="hidden" name="turnirId" value="@Model.ID" />
                    <button type="submit" class="btn btn-orange text-white fw-bold"><i class="bi bi-lightning-fill me-2"></i>Generiši parove</button>
                </form>
            }
            else
            {
                <p class="text-white-50 small mb-0">Parovi glavnog turnira će biti dostupni nakon što svi mečevi grupne faze budu odigrani.</p>
            }
        </div>
        }
    }
    else if (!Model.ZavrsniMecevi.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-info-circle text-white-50 fs-2 mb-3"></i>
            <h5 class="text-white">Nema mečeva glavnog turnira</h5>
            <p class="text-white-50 small mb-0">Mečevi glavnog turnira nisu dostupni.</p>
        </div>
    }
    else
    {
        @foreach (var runda in rundeZavrsnice)
        {
            var rNo = runda.Key;
            var rMatches = runda.ToList();
            var matchesCount = rMatches.Count;

            string rundaNaziv = $"KOLO {rNo}";
            if (matchesCount == 1)
            {
                rundaNaziv = "FINALE";
            }
            else if (matchesCount == 2)
            {
                rundaNaziv = "POLUFINALE";
            }
            else if (matchesCount == 4)
            {
                rundaNaziv = "ČETVRTFINALE";
            }
            else if (matchesCount == 8)
            {
                rundaNaziv = "OSMINA FINALA";
            }
            else if (matchesCount == 16)
            {
                rundaNaziv = "ŠESNAESTINA FINALA";
            }

            <div class="d-flex justify-content-between align-items-center border-bottom border-dark-glow pb-2 mb-3 mt-4">
                <h5 class="text-orange fw-bold mb-0 text-uppercase">@rundaNaziv</h5>
                <button class="btn btn-outline-light-glow btn-sm btn-collapse-toggle rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" type="button" data-bs-toggle="collapse" data-bs-target="#roundCollapse-@rNo" aria-expanded="true" aria-controls="roundCollapse-@rNo">
                    <i class="bi bi-chevron-up toggle-chevron" style="font-size: 0.75rem;"></i>
                </button>
            </div>

            <div class="collapse show" id="roundCollapse-@rNo">
                <div class="row g-3">
                @foreach (var mec in rMatches)
                {
                    <div class="col-12">
                        <div class="match-card p-3 bg-dark-input border border-dark-glow rounded-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center flex-grow-1">
                                <div class="text-end flex-grow-1 pe-3">
                                    @if (mec.Igrac1ID != null)
                                    {
                                        <a href="/Korisnik/Index/@mec.Igrac1ID" class="text-white hover-orange fw-semibold">
                                            @mec.Igrac1?.Ime @mec.Igrac1?.Prezime
                                            @if (mec.Igrac1 != null && mec.Igrac1.IsGost)
                                            {
                                                <span class="text-muted small">(Gost)</span>
                                            }
                                        </a>
                                    }
                                    else
                                    {
                                        if (rNo > 1)
                                        {
                                            var mNo = int.Parse(mec.MatchCode.Split('_').Last().Substring(1));
                                            var srcMatchNo = 2 * mNo - 1;
                                            <span class="text-white-50 small text-uppercase italic">Pobjednik R@(rNo - 1) M@(srcMatchNo)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Slobodan prolaz (BYE)</span>
                                        }
                                    }
                                </div>

                                <div class="score-display px-3 py-1 rounded bg-dark border border-dark-glow text-center mx-2" style="min-width: 80px;">
                                    @if (mec.Odigran)
                                    {
                                        <span class="text-orange fw-bold fs-5">@mec.PoeniIgrac1 : @mec.PoeniIgrac2</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted font-monospace small">VS</span>
                                    }
                                </div>

                                <div class="text-start flex-grow-1 ps-3">
                                    @if (mec.Igrac2ID != null)
                                    {
                                        <a href="/Korisnik/Index/@mec.Igrac2ID" class="text-white hover-orange fw-semibold">
                                            @mec.Igrac2?.Ime @mec.Igrac2?.Prezime
                                            @if (mec.Igrac2 != null && mec.Igrac2.IsGost)
                                            {
                                                <span class="text-muted small">(Gost)</span>
                                            }
                                        </a>
                                    }
                                    else
                                    {
                                        if (rNo > 1)
                                        {
                                            var mNo = int.Parse(mec.MatchCode.Split('_').Last().Substring(1));
                                            var srcMatchNo = 2 * mNo;
                                            <span class="text-white-50 small text-uppercase italic">Pobjednik R@(rNo - 1) M@(srcMatchNo)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Slobodan prolaz (BYE)</span>
                                        }
                                    }
                                </div>
                            </div>

                            @if (Model.IsOrganizator && mec.Igrac1ID != null && mec.Igrac2ID != null && mec.Igrac1ID != "SLOBODAN" && mec.Igrac2ID != "SLOBODAN")
                            {
                                <div class="ps-3 border-start border-secondary ms-3">
                                    <button type="button" class="btn btn-outline-warning btn-sm fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#unosRezultataModal"
                                            data-mec-id="@mec.ID"
                                            data-igrac1="@(mec.Igrac1?.Ime + " " + mec.Igrac1?.Prezime)"
                                            data-igrac1-partner="@(mec.Igrac1Partner != null ? mec.Igrac1Partner.Ime + " " + mec.Igrac1Partner.Prezime : "")"
                                            data-igrac2="@(mec.Igrac2?.Ime + " " + mec.Igrac2?.Prezime)"
                                            data-igrac2-partner="@(mec.Igrac2Partner != null ? mec.Igrac2Partner.Ime + " " + mec.Igrac2Partner.Prezime : "")"
                                            data-poeni1="@(mec.PoeniIgrac1 ?? 0)"
                                            data-poeni2="@(mec.PoeniIgrac2 ?? 0)"
                                            data-runda="@mec.Runda"
                                            data-grupa="@mec.NazivGrupe">
                                        <i class="bi bi-trophy-fill"></i> Unos
                                    </button>
                                </div>
                            }
                    </div>
                    </div>
                }
                </div>
            </div>
        }
    }
</div>