@model ePinPong.Models.Turnir
@{
    ViewData["Title"] = "Uredi turnir";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAdmin = User.IsInRole("Administrator");
    var canDelete = isAdmin;
    var returnUrl = ViewBag.ReturnUrl as string;
    var isZavrsen = Model.Status == ePinPong.Models.StatusTurnira.Zavrsen;
    var isReadOnlyForOrg = !isAdmin && isZavrsen;
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-lg-8">
        <div class="card bg-dark-card border border-dark-glow rounded-4 shadow-lg overflow-hidden">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-4">
                <h3 class="text-white fw-bold mb-1"><i class="bi bi-pencil-square text-orange me-2"></i>Uredi turnir: @Model.Naziv</h3>
                <p class="text-white-50 mb-0">Uredite informacije o turniru u nastavku.</p>
            </div>
            <div class="card-body p-4">
                @if (isReadOnlyForOrg)
                {
                    <div class="alert alert-warning rounded-4 p-3 mb-4 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div>
                            <strong class="d-block mb-1">Turnir je završen!</strong>
                            <span class="small">Kao organizator završenog turnira, možete mijenjati samo ligu kojoj turnir pripada. Ostale informacije su zaključane.</span>
                        </div>
                    </div>
                }

                <form id="edit-form" asp-action="Edit" method="post">
                    <input type="hidden" asp-for="ID" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label asp-for="Naziv" class="form-label text-white fw-semibold">Naziv turnira</label>
                            <input asp-for="Naziv" class="form-control bg-dark-input border-dark-glow text-white" disabled="@(isReadOnlyForOrg ? "disabled" : null)" />
                            <span asp-validation-for="Naziv" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Status" class="form-label text-white fw-semibold">Status turnira</label>
                            <select asp-for="Status" class="form-select bg-dark-input border-dark-glow text-white" asp-items="ViewBag.StatusList" disabled="@(isReadOnlyForOrg ? "disabled" : null)">
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="MaxIgraca" class="form-label text-white fw-semibold">Maksimalan broj igrača</label>
                            <input asp-for="MaxIgraca" type="number" min="2" class="form-control bg-dark-input border-dark-glow text-white" disabled="@(isReadOnlyForOrg ? "disabled" : null)" />
                            <span asp-validation-for="MaxIgraca" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="LigaID" class="form-label text-white fw-semibold">Liga kojoj turnir pripada</label>
                            <select asp-for="LigaID" class="form-select bg-dark-input border-dark-glow text-white" asp-items="ViewBag.Lige">
                            </select>
                            <span asp-validation-for="LigaID" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DatumPocetka" class="form-label text-white fw-semibold">Datum početka</label>
                            <input asp-for="DatumPocetka" class="form-control bg-dark-input border-dark-glow text-white" disabled="@(isReadOnlyForOrg ? "disabled" : null)" />
                            <span asp-validation-for="DatumPocetka" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DatumKraja" class="form-label text-white fw-semibold">Datum završetka</label>
                            <input asp-for="DatumKraja" class="form-control bg-dark-input border-dark-glow text-white" disabled="@(isReadOnlyForOrg ? "disabled" : null)" />
                            <span asp-validation-for="DatumKraja" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Lokacija" class="form-label text-white fw-semibold">Lokacija / Dvorana</label>
                            <input asp-for="Lokacija" class="form-control bg-dark-input border-dark-glow text-white" disabled="@(isReadOnlyForOrg ? "disabled" : null)" />
                            <span asp-validation-for="Lokacija" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="SlikaUrl" class="form-label text-white fw-semibold">URL Slike turnira (Opcionalno)</label>
                            <input asp-for="SlikaUrl" class="form-control bg-dark-input border-dark-glow text-white" disabled="@(isReadOnlyForOrg ? "disabled" : null)" />
                            <span asp-validation-for="SlikaUrl" class="text-danger small"></span>
                        </div>

                        <!-- Widget za format i sistem turnira -->
                        <div class="col-12 my-3">
                            <div class="p-4 bg-dark-input border border-dark-glow rounded-4">
                                <h5 class="text-white fw-bold mb-3"><i class="bi bi-sliders text-orange me-2"></i>Format i Sistem Turnira</h5>

                                @{
                                    var isMastersTurnir = (ViewBag.IsMasters as bool? == true) || (Model.Liga != null && Model.Kolo.HasValue && Model.Kolo.Value == ePinPong.Services.LigaTurnirHelper.GetMastersKolo(Model.Liga));
                                }
                                @if (isMastersTurnir)
                                {
                                    <div class="p-4 bg-dark-card border border-warning rounded-4 text-center">
                                        <i class="bi bi-trophy-fill text-warning display-4 mb-2 d-block"></i>
                                        <h4 class="text-white fw-bold mb-1">Završni masters turnir</h4>
                                        <p class="text-white-50 small mb-0">Format i sistem takmičenja za Masters su unaprijed definisani rang listom lige i pravilima završnice.</p>
                                    </div>
                                }
                                else
                                {
                                    <!-- 1. Tip Takmičenja -->
                                    <div class="mb-4">
                                        <label class="form-label text-white fw-semibold mb-2 d-block">Tip Takmičenja</label>
                                        <div class="row g-2">
                                            <div class="col-12 col-md-6">
                                                <input type="radio" class="btn-check" name="TipTakmicenja" id="tipSingl" value="Singl" @(Model.TipTakmicenja == ePinPong.Models.TipTakmicenja.Singl ? "checked" : "") disabled="@(isReadOnlyForOrg ? "disabled" : null)" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="tipSingl">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-person-fill text-orange fs-3 me-3"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Samo Singl</strong>
                                                            <small class="text-white-50">Turnir se igra pojedinačno</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>

                                            <div class="col-12 col-md-6">
                                                <input type="radio" class="btn-check" name="TipTakmicenja" id="tipSinglIDubl" value="SinglIDubl" @(Model.TipTakmicenja == ePinPong.Models.TipTakmicenja.SinglIDubl ? "checked" : "") disabled="@(isReadOnlyForOrg ? "disabled" : null)" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="tipSinglIDubl">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-diagram-2-fill text-orange fs-3 me-3"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Singl + Dubl</strong>
                                                            <small class="text-white-50">Pojedinačno i u parovima</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. Sistem Turnira / Format Završnice -->
                                    <div>
                                        <label class="form-label text-white fw-semibold mb-2 d-block">Sistem Turnira (Format Završnice)</label>
                                        <div class="row g-2">
                                            <div class="col-12 col-lg-4">
                                                <input type="radio" class="btn-check" name="SistemTurnira" id="sysSingle" value="SingleElimination" @(Model.SistemTurnira == ePinPong.Models.SistemTurnira.SingleElimination ? "checked" : "") disabled="@(isReadOnlyForOrg ? "disabled" : null)" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="sysSingle">
                                                    <div class="d-flex align-items-start">
                                                        <i class="bi bi-trophy text-warning fs-3 me-3 mt-1"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Single Elimination</strong>
                                                            <small class="text-white-50 d-block mt-1">Grupna faza + Završnica. Bez razigravanja i utješnog.</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="col-12 col-lg-4">
                                                <input type="radio" class="btn-check" name="SistemTurnira" id="sysDouble" value="DoubleElimination" @(Model.SistemTurnira == ePinPong.Models.SistemTurnira.DoubleElimination ? "checked" : "") disabled="@(isReadOnlyForOrg ? "disabled" : null)" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="sysDouble">
                                                    <div class="d-flex align-items-start">
                                                        <i class="bi bi-diagram-3-fill text-info fs-3 me-3 mt-1"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Double Elimination</strong>
                                                            <small class="text-white-50 d-block mt-1">Grupna faza + Završnica sa razigravanjem. Bez utješnog turnira.</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="col-12 col-lg-4">
                                                <input type="radio" class="btn-check" name="SistemTurnira" id="sysDoubleUtjesni" value="DoubleEliminationUtjesni" @(Model.SistemTurnira == ePinPong.Models.SistemTurnira.DoubleEliminationUtjesni ? "checked" : "") disabled="@(isReadOnlyForOrg ? "disabled" : null)" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="sysDoubleUtjesni">
                                                    <div class="d-flex align-items-start">
                                                        <i class="bi bi-patch-check-fill text-orange fs-3 me-3 mt-1"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Double Elimination + Utješni</strong>
                                                            <small class="text-white-50 d-block mt-1">Grupna faza + Završnica sa razigravanjem + Utješni turnir.</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Opis" class="form-label text-white fw-semibold">Opis i pravila turnira</label>
                            <textarea asp-for="Opis" rows="4" class="form-control bg-dark-input border-dark-glow text-white" disabled="@(isReadOnlyForOrg ? "disabled" : null)"></textarea>
                            <span asp-validation-for="Opis" class="text-danger small"></span>
                        </div>
                    </div>

                </form>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-dark-glow">
                    <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-outline-light-glow text-white fw-bold"><i class="bi bi-arrow-left me-2"></i>Nazad</a>
                    <div class="d-flex gap-2">
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@Model.ID" method="post" onsubmit="return confirm('Obrisat ćete turnir i sve povezane prijave, mečeve i parove. Jeste li sigurni?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (!string.IsNullOrWhiteSpace(returnUrl))
                                {
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                }
                                <button type="submit" class="btn btn-danger px-4 py-2 fw-bold"><i class="bi bi-trash3-fill me-2"></i>Obriši turnir</button>
                            </form>
                        }
                        <button type="submit" form="edit-form" class="btn btn-orange px-4 py-2 text-white fw-bold shadow-glow">Spremi izmjene <i class="bi bi-save ms-2"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
