@model ePinPong.Models.ViewModels.TurnirDetailsViewModel

@{
    var isOrganizator = Model.IsOrganizator;

    var paroviMecevi = Model.Mecevi.Where(m => m.TipMeca == TipMeca.TurnirParova).ToList();
    var rundeParova = paroviMecevi.GroupBy(m => m.Runda).OrderBy(g => g.Key).ToList();
    bool isParoviGrupa = paroviMecevi.Any(m => !string.IsNullOrEmpty(m.NazivGrupe));

    var maxRundaParova = rundeParova.Any() ? rundeParova.Max(g => g.Key) : 0;
    var finalniMecParova = paroviMecevi.FirstOrDefault(m => m.Runda == maxRundaParova);

    bool paroviZavrseni = false;

    var podium = new ePinPong.Models.ViewModels.DoublesPodiumViewModel();

    if (isParoviGrupa)
    {
        paroviZavrseni = paroviMecevi.Count > 0 && paroviMecevi.All(m => m.Odigran);

        // Standings po grupama (samo za određivanje pobjednika za postolje)
        var meceviPoGrupamaParova = paroviMecevi.GroupBy(m => m.NazivGrupe).OrderBy(g => g.Key).ToList();
        foreach (var grupaGroup in meceviPoGrupamaParova)
        {
            string gName = grupaGroup.Key ?? "Grupa A (Parovi)";
            var meceviGrupe = grupaGroup.ToList();

            var paroviSet = new List<(string I1Id, string I2Id, ePinPong.Models.ApplicationUser? I1, ePinPong.Models.ApplicationUser? I2)>();
            foreach (var p in Model.TurnirParovi)
            {
                if (p.Igrac1ID != null && p.Igrac2ID != null)
                {
                    if (!paroviSet.Any(x => (x.I1Id == p.Igrac1ID && x.I2Id == p.Igrac2ID) || (x.I1Id == p.Igrac2ID && x.I2Id == p.Igrac1ID)))
                        paroviSet.Add((p.Igrac1ID, p.Igrac2ID, p.Igrac1, p.Igrac2));
                }
            }
            foreach (var m in meceviGrupe)
            {
                if (m.Igrac1ID != null && m.Igrac1PartnerID != null)
                {
                    if (!paroviSet.Any(x => (x.I1Id == m.Igrac1ID && x.I2Id == m.Igrac1PartnerID) || (x.I1Id == m.Igrac1PartnerID && x.I2Id == m.Igrac1ID)))
                        paroviSet.Add((m.Igrac1ID, m.Igrac1PartnerID, m.Igrac1, m.Igrac1Partner));
                }
                if (m.Igrac2ID != null && m.Igrac2PartnerID != null)
                {
                    if (!paroviSet.Any(x => (x.I1Id == m.Igrac2ID && x.I2Id == m.Igrac2PartnerID) || (x.I1Id == m.Igrac2PartnerID && x.I2Id == m.Igrac2ID)))
                        paroviSet.Add((m.Igrac2ID, m.Igrac2PartnerID, m.Igrac2, m.Igrac2Partner));
                }
            }

            var records = new List<dynamic>();
            foreach (var pTuple in paroviSet)
            {
                int pobjede = 0, porazi = 0, osvojeniSetovi = 0, izgubljeniSetovi = 0;
                foreach (var m in meceviGrupe.Where(m => m.Odigran))
                {
                    bool isSide1 = (m.Igrac1ID == pTuple.I1Id && m.Igrac1PartnerID == pTuple.I2Id) || (m.Igrac1ID == pTuple.I2Id && m.Igrac1PartnerID == pTuple.I1Id);
                    bool isSide2 = (m.Igrac2ID == pTuple.I1Id && m.Igrac2PartnerID == pTuple.I2Id) || (m.Igrac2ID == pTuple.I2Id && m.Igrac2PartnerID == pTuple.I1Id);
                    if (isSide1) { int p1 = m.PoeniIgrac1 ?? 0, p2 = m.PoeniIgrac2 ?? 0; osvojeniSetovi += p1; izgubljeniSetovi += p2; if (p1 > p2) pobjede++; else porazi++; }
                    else if (isSide2) { int p1 = m.PoeniIgrac1 ?? 0, p2 = m.PoeniIgrac2 ?? 0; osvojeniSetovi += p2; izgubljeniSetovi += p1; if (p2 > p1) pobjede++; else porazi++; }
                }
                records.Add(new { Igrac1 = pTuple.I1, Igrac2 = pTuple.I2, Pobjede = pobjede, Porazi = porazi, SetRazlika = osvojeniSetovi - izgubljeniSetovi });
            }

            var sortirani = records.OrderByDescending(r => r.Pobjede).ThenByDescending(r => r.SetRazlika).ToList();
            if (paroviZavrseni)
            {
                if (sortirani.Count > 0) { podium.Prvo_Igrac1  = sortirani[0].Igrac1; podium.Prvo_Igrac2  = sortirani[0].Igrac2; }
                if (sortirani.Count > 1) { podium.Drugo_Igrac1 = sortirani[1].Igrac1; podium.Drugo_Igrac2 = sortirani[1].Igrac2; }
                if (sortirani.Count > 2) podium.TrecaMjesta.Add((sortirani[2].Igrac1, sortirani[2].Igrac2));
            }
        }
    }
    else
    {
        paroviZavrseni = finalniMecParova != null && finalniMecParova.Odigran;
        if (paroviZavrseni && finalniMecParova != null)
        {
            bool isIgrac1Pobjednik = (finalniMecParova.PoeniIgrac1 ?? 0) > (finalniMecParova.PoeniIgrac2 ?? 0);
            if (isIgrac1Pobjednik)
            {
                podium.Prvo_Igrac1  = finalniMecParova.Igrac1;        podium.Prvo_Igrac2  = finalniMecParova.Igrac1Partner;
                podium.Drugo_Igrac1 = finalniMecParova.Igrac2;        podium.Drugo_Igrac2 = finalniMecParova.Igrac2Partner;
            }
            else
            {
                podium.Prvo_Igrac1  = finalniMecParova.Igrac2;        podium.Prvo_Igrac2  = finalniMecParova.Igrac2Partner;
                podium.Drugo_Igrac1 = finalniMecParova.Igrac1;        podium.Drugo_Igrac2 = finalniMecParova.Igrac1Partner;
            }

            if (maxRundaParova > 1)
            {
                var polufinalniMecevi = paroviMecevi.Where(m => m.Runda == maxRundaParova - 1).ToList();
                foreach (var pfMec in polufinalniMecevi)
                {
                    if (pfMec.Odigran)
                    {
                        bool pfIgrac1Pobjednik = (pfMec.PoeniIgrac1 ?? 0) > (pfMec.PoeniIgrac2 ?? 0);
                        if (pfIgrac1Pobjednik) { if (pfMec.Igrac2ID != null) podium.TrecaMjesta.Add((pfMec.Igrac2, pfMec.Igrac2Partner)); }
                        else                   { if (pfMec.Igrac1ID != null) podium.TrecaMjesta.Add((pfMec.Igrac1, pfMec.Igrac1Partner)); }
                    }
                }
            }
        }
    }
}

<!-- Pane: Turnir Parova -->
<div class="tab-pane fade" id="doubles-pane" role="tabpanel" aria-labelledby="doubles-tab" tabindex="0">

    @if (!paroviMecevi.Any())
    {
        <!-- Faza registracije: lista parova + forme -->
        <partial name="Doubles/_DoublesRegistration" model="Model" />
    }
    else
    {
        <!-- Dugme za ponovnu generaciju (samo za organizatora) -->
        @if (isOrganizator)
        {
            <div class="d-flex justify-content-end mb-4">
                <form asp-controller="Mec" asp-action="GenerirajTurnirParova" method="post"
                      onsubmit="return confirm('Da li ste sigurni? Ovo će obrisati sve trenutne mečeve parova i njihove rezultate.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="turnirId" value="@Model.ID" />
                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                        <i class="bi bi-arrow-counterclockwise"></i> Ponovo generiši parove
                    </button>
                </form>
            </div>
        }

        <!-- Postolje pobjednika (prikazuje se kada su svi mečevi odigrani) -->
        @if (paroviZavrseni && podium.Prvo_Igrac1 != null)
        {
            <partial name="Doubles/_DoublesPodium" model="podium" />
        }

        <!-- Grupna tabela i mečevi / Knockout bracket -->
        @if (isParoviGrupa)
        {
            <partial name="Doubles/_DoublesGroupView" model="Model" />
        }
        else
        {
            <partial name="Doubles/_DoublesKnockoutView" model="Model" />
        }
    }

</div>
