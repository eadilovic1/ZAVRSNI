@model ePinPong.Models.Turnir
@{
    ViewData["Title"] = "Objavi novi turnir";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-lg-8">
        <div class="card bg-dark-card border border-dark-glow rounded-4 shadow-lg overflow-hidden">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-4">
                <h3 class="text-white fw-bold mb-1"><i class="bi bi-trophy-fill text-orange me-2"></i>Objavi novi turnir</h3>
                <p class="text-white-50 mb-0">Popunite podatke ispod kako biste kreirali novi stolnoteniski turnir.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    @if (ViewBag.LockedLigaId != null)
                    {
                        <div class="alert @(ViewBag.CreateMode == "Masters" ? "alert-warning" : "alert-info") border-0 rounded-3 mb-4">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi @(ViewBag.CreateMode == "Masters" ? "bi-trophy-fill" : "bi-info-circle-fill") fs-5 mt-1"></i>
                                <div>
                                    <strong>@(ViewBag.CreateMode == "Masters" ? "Kreirate završni Masters" : "Kreirate regularni turnir")</strong>
                                    <div class="small">@ViewBag.CreateModeMessage</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Naziv" class="form-label text-white fw-semibold">Naziv turnira</label>
                            <input asp-for="Naziv" class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" placeholder="Unesite naziv turnira..." />
                            <span asp-validation-for="Naziv" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="MaxIgraca" class="form-label text-white fw-semibold">Maksimalan broj igrača</label>
                            <input asp-for="MaxIgraca" type="number" min="2" class="form-control bg-dark-input border-dark-glow text-white" placeholder="Npr. 16, 32..." />
                            <span asp-validation-for="MaxIgraca" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="LigaID" class="form-label text-white fw-semibold">Liga kojoj turnir pripada</label>
                            @if (ViewBag.LockedLigaId != null)
                            {
                                <div class="form-control bg-dark-input border-dark-glow text-white d-flex align-items-center" style="cursor:not-allowed; opacity:.85;">
                                    <i class="bi bi-lock-fill text-orange me-2"></i>
                                    <span>@ViewBag.LockedLigaNaziv</span>
                                </div>
                                <input type="hidden" asp-for="LigaID" />
                                <small class="text-white-50">Liga je automatski odabrana jer ste turnir kreirali iz pregleda te lige.</small>
                                @if (ViewBag.CreateMode == "Masters")
                                {
                                    <input type="hidden" name="Kolo" value="@ViewBag.MastersKolo" />
                                }
                            }
                            else
                            {
                                <select asp-for="LigaID" class="form-select bg-dark-input border-dark-glow text-white" asp-items="ViewBag.Lige"></select>
                                <span asp-validation-for="LigaID" class="text-danger small"></span>
                            }
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DatumPocetka" class="form-label text-white fw-semibold">Datum početka</label>
                            <input asp-for="DatumPocetka" type="datetime-local" class="form-control bg-dark-input border-dark-glow text-white" />
                            <span asp-validation-for="DatumPocetka" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DatumKraja" class="form-label text-white fw-semibold">Datum završetka</label>
                            <input asp-for="DatumKraja" type="datetime-local" class="form-control bg-dark-input border-dark-glow text-white" />
                            <span asp-validation-for="DatumKraja" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Lokacija" class="form-label text-white fw-semibold">Lokacija / Dvorana</label>
                            <input asp-for="Lokacija" class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" placeholder="Npr. Dvorana KSC, Sarajevo..." />
                            <span asp-validation-for="Lokacija" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="SlikaUrl" class="form-label text-white fw-semibold">URL Slike turnira (Opcionalno)</label>
                            <input asp-for="SlikaUrl" class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" placeholder="https://example.com/slika.jpg..." />
                            <span asp-validation-for="SlikaUrl" class="text-danger small"></span>
                        </div>

                        <!-- Widget za format i sistem turnira -->
                        <div class="col-12 my-3">
                            <div class="p-4 bg-dark-input border border-dark-glow rounded-4">
                                <h5 class="text-white fw-bold mb-3"><i class="bi bi-sliders text-orange me-2"></i>Format i Sistem Turnira</h5>

                                @if ((string)ViewBag.CreateMode == "Masters")
                                {
                                    <div class="p-4 bg-dark-card border border-warning rounded-4 text-center">
                                        <i class="bi bi-trophy-fill text-warning display-4 mb-2 d-block"></i>
                                        <h4 class="text-white fw-bold mb-1">Završni masters turnir</h4>
                                        <p class="text-white-50 small mb-0">Format i sistem takmičenja za Masters su unaprijed definisani rang listom lige i pravilima završnice.</p>
                                    </div>
                                }
                                else
                                {
                                    <!-- 1. Tip Takmičenja -->
                                    <div class="mb-4">
                                        <label class="form-label text-white fw-semibold mb-2 d-block">Tip Takmičenja</label>
                                        <div class="row g-2">
                                            <div class="col-12 col-md-6">
                                                <input type="radio" class="btn-check" name="TipTakmicenja" id="tipSingl" value="Singl" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="tipSingl">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-person-fill text-orange fs-3 me-3"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Samo Singl</strong>
                                                            <small class="text-white-50">Turnir se igra pojedinačno</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>

                                            <div class="col-12 col-md-6">
                                                <input type="radio" class="btn-check" name="TipTakmicenja" id="tipSinglIDubl" value="SinglIDubl" checked autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="tipSinglIDubl">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-diagram-2-fill text-orange fs-3 me-3"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Singl + Dubl</strong>
                                                            <small class="text-white-50">Pojedinačno i u parovima</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. Sistem Turnira / Format Završnice -->
                                    <div>
                                        <label class="form-label text-white fw-semibold mb-2 d-block">Sistem Turnira (Format Završnice)</label>
                                        <div class="row g-2">
                                            <div class="col-12 col-lg-4">
                                                <input type="radio" class="btn-check" name="SistemTurnira" id="sysSingle" value="SingleElimination" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="sysSingle">
                                                    <div class="d-flex align-items-start">
                                                        <i class="bi bi-trophy text-warning fs-3 me-3 mt-1"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Single Elimination</strong>
                                                            <small class="text-white-50 d-block mt-1">Grupna faza + Završnica. Bez razigravanja i utješnog.</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="col-12 col-lg-4">
                                                <input type="radio" class="btn-check" name="SistemTurnira" id="sysDouble" value="DoubleElimination" autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="sysDouble">
                                                    <div class="d-flex align-items-start">
                                                        <i class="bi bi-diagram-3-fill text-info fs-3 me-3 mt-1"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Double Elimination</strong>
                                                            <small class="text-white-50 d-block mt-1">Grupna faza + Završnica sa razigravanjem. Bez utješnog turnira.</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="col-12 col-lg-4">
                                                <input type="radio" class="btn-check" name="SistemTurnira" id="sysDoubleUtjesni" value="DoubleEliminationUtjesni" checked autocomplete="off">
                                                <label class="btn btn-outline-light-glow w-100 p-3 text-start h-100 rounded-3 border-dark-glow" for="sysDoubleUtjesni">
                                                    <div class="d-flex align-items-start">
                                                        <i class="bi bi-patch-check-fill text-orange fs-3 me-3 mt-1"></i>
                                                        <div>
                                                            <strong class="d-block text-white">Double Elimination + Utješni</strong>
                                                            <small class="text-white-50 d-block mt-1">Grupna faza + Završnica sa razigravanjem + Utješni turnir.</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Opis" class="form-label text-white fw-semibold">Opis i pravila turnira</label>
                            <textarea asp-for="Opis" rows="4" class="form-control bg-dark-input border-dark-glow text-white placeholder-muted" placeholder="Unesite detaljan opis turnira, pravila, učešće, nagrade..."></textarea>
                            <span asp-validation-for="Opis" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-dark-glow">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light-glow text-white fw-bold"><i class="bi bi-arrow-left me-2"></i>Nazad</a>
                        <button type="submit" class="btn btn-orange px-4 py-2 text-white fw-bold shadow-glow">@(ViewBag.CreateMode == "Masters" ? "Objavi Masters" : "Objavi Turnir") <i class="bi bi-check2-circle ms-2"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ligaSelect = document.getElementById("LigaID");
            const datumPocetkaInput = document.getElementById("DatumPocetka");
            const datumKrajaInput = document.getElementById("DatumKraja");
            const ligaDatesJson = @Html.Raw(ViewBag.LigaDatesJson ?? "{}");

            if (ligaSelect && datumPocetkaInput && datumKrajaInput && ligaDatesJson) {
                ligaSelect.addEventListener("change", function () {
                    const selectedLigaId = this.value || "";
                    const dates = ligaDatesJson[selectedLigaId];
                    if (dates && dates.start && dates.end) {
                        datumPocetkaInput.value = dates.start;
                        datumKrajaInput.value = dates.end;
                    }
                });
            }
        });
    </script>
}
