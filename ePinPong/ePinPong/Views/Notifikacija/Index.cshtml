@model IEnumerable<ePinPong.Models.Notifikacija>
@{
    ViewData["Title"] = "Moja Obavještenja";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-lg-8">
        <div class="card bg-dark-card border border-dark-glow rounded-4 overflow-hidden shadow-lg">
            <div class="card-header bg-dark-card-footer border-bottom border-dark-glow p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="text-white fw-bold mb-1"><i class="bi bi-bell-fill text-orange me-2"></i>Moja Obavještenja</h3>
                    <p class="text-white-50 mb-0 small">Pregledajte sva vaša in-app obavještenja sa platforme.</p>
                </div>
                
                @if (Model.Any(n => !n.Procitana))
                {
                    <form asp-action="MarkAllAsRead" method="post">
                        <button type="submit" class="btn btn-outline-light-glow btn-sm text-white fw-bold"><i class="bi bi-check2-all me-1"></i>Označi sve kao pročitano</button>
                    </form>
                }
            </div>
            
            <div class="card-body p-4">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-white-50">
                        <i class="bi bi-bell-slash fs-1 text-muted mb-3 d-block"></i>Nemate nikakvih obavještenja.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var notifikacija in Model)
                        {
                            var highlightKlasa = notifikacija.Procitana ? "border-dark-glow" : "border-warning bg-warning-transparent";

                            <div class="p-3 rounded-3 bg-dark-input border @highlightKlasa d-flex justify-content-between align-items-center">
                                <div class="pe-3">
                                    <div class="text-white">@Html.Raw(notifikacija.Sadrzaj)</div>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>@notifikacija.DatumKreiranja.ToString("dd.MM.yyyy u HH:mm")</small>
                                </div>

                                @if (!notifikacija.Procitana)
                                {
                                    <form asp-action="MarkAsRead" asp-route-id="@notifikacija.ID" method="post" class="ms-3">
                                        <button type="submit" class="btn btn-orange btn-sm text-white fw-bold"><i class="bi bi-check2"></i> Pročitano</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
